@using Firma.Data.Data.Sklep
@model IEnumerable<Firma.Data.Data.Sklep.Zamowienie>

@{
    ViewData["Title"] = "Zamówienia";
    var czyAdministrator = User.IsInRole("Administrator");
    var zamowienia = Model?.ToList() ?? new List<Zamowienie>();

    var wybraneZrodlo = ViewBag.WybraneZrodlo as string ?? string.Empty;
    var wybranyStatus = ViewBag.WybranyStatus as string ?? string.Empty;

    var liczbaZamowienWWW = zamowienia.Count(z =>
        !string.IsNullOrWhiteSpace(z.NumerZamowienia) &&
        z.NumerZamowienia.StartsWith("WWW", StringComparison.OrdinalIgnoreCase));
}

<style>
    .zamowienie-mobile-list {
        display: none;
    }

    .zamowienie-mobile-card {
        border: 1px solid #dee2e6;
        border-radius: 0.75rem;
        background-color: #ffffff;
        padding: 1rem;
        margin-bottom: 1rem;
        box-shadow: 0 0.125rem 0.4rem rgba(0, 0, 0, 0.06);
    }

    .zamowienie-mobile-card-www {
        border-color: #86b7fe;
        background-color: #f8fbff;
    }

    .zamowienie-www-row {
        --bs-table-bg: #f8fbff;
    }

    .zamowienie-mobile-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem;
    }

        .zamowienie-mobile-actions .btn {
            width: 100%;
        }

    .zamowienie-mobile-info {
        display: grid;
        grid-template-columns: 40% 60%;
        gap: 0.35rem 0.75rem;
        margin-bottom: 1rem;
    }

        .zamowienie-mobile-info dt {
            color: #6c757d;
            font-weight: 600;
            margin-bottom: 0;
        }

        .zamowienie-mobile-info dd {
            margin-bottom: 0;
            word-break: break-word;
        }

    .zamowienie-zrodlo-box {
        border: 1px solid #dee2e6;
        border-radius: 0.75rem;
        background-color: #ffffff;
        padding: 1rem;
    }

    @@media (max-width: 767.98px) {
        .zamowienie-desktop-table {
            display: none;
        }

        .zamowienie-mobile-list {
            display: block;
        }

        .zamowienie-toolbar {
            align-items: stretch !important;
        }

            .zamowienie-toolbar .btn {
                width: 100%;
            }

        .crud-naglowek {
            display: block;
        }

            .crud-naglowek .btn,
            .crud-naglowek .btn-group-responsive .btn {
                width: 100%;
                margin-top: 0.75rem;
            }

        .btn-group-responsive {
            width: 100%;
        }
    }
</style>

<div class="crud-naglowek">
    <div>
        <h1 class="h2 mb-1">Zamówienia</h1>
        <p class="crud-podtytul">Lista zamówień ręcznych oraz zamówień z portalu WWW.</p>
    </div>

    <div class="d-flex gap-2 flex-wrap btn-group-responsive">
        <a asp-action="PobierzZamowieniaExcel"
           class="btn btn-outline-success">
            Eksport Excel
        </a>

        @if (czyAdministrator)
        {
            <a asp-action="ImportExcel"
               class="btn btn-outline-primary">
                Import Excel
            </a>
        }

        <a asp-action="Create" class="btn btn-primary">
            Dodaj nowy rekord
        </a>
    </div>
</div>

@if (TempData["Komunikat"] != null)
{
    <div class="alert alert-info">
        @TempData["Komunikat"]
    </div>
}

<form asp-action="Index"
      method="get"
      class="card crud-karta mb-3">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label for="zrodlo" class="form-label">Źródło</label>
                <select id="zrodlo" name="zrodlo" class="form-select">
                    <option value="" selected="@(string.IsNullOrWhiteSpace(wybraneZrodlo))">Wszystkie</option>
                    <option value="www" selected="@(wybraneZrodlo == "www")">Portal WWW</option>
                    <option value="intranet" selected="@(wybraneZrodlo == "intranet")">Intranet</option>
                </select>
            </div>

            <div class="col-12 col-md-4">
                <label for="status" class="form-label">Status</label>
                <select id="status" name="status" class="form-select">
                    <option value="" selected="@(string.IsNullOrWhiteSpace(wybranyStatus))">Wszystkie</option>
                    <option value="Nowe" selected="@(wybranyStatus == "Nowe")">Nowe</option>
                    <option value="w trakcie" selected="@(wybranyStatus == "w trakcie")">w trakcie</option>
                    <option value="wysłane" selected="@(wybranyStatus == "wysłane")">wysłane</option>
                    <option value="zakończone" selected="@(wybranyStatus == "zakończone")">zakończone</option>
                    <option value="anulowane" selected="@(wybranyStatus == "anulowane")">anulowane</option>
                </select>
            </div>

            <div class="col-12 col-md-4">
                <div class="d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-primary">
                        Filtruj
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Wyczyść
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>

<div class="row g-3 mb-3">
    <div class="col-12 col-md-4">
        <div class="zamowienie-zrodlo-box">
            <div class="text-muted small">Widoczne zamówienia</div>
            <div class="h4 mb-0">@zamowienia.Count</div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="zamowienie-zrodlo-box">
            <div class="text-muted small">Widoczne z portalu WWW</div>
            <div class="h4 mb-0">@liczbaZamowienWWW</div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="zamowienie-zrodlo-box">
            <div class="text-muted small">Widoczne ręczne / import</div>
            <div class="h4 mb-0">@(zamowienia.Count - liczbaZamowienWWW)</div>
        </div>
    </div>
</div>

<div class="card crud-karta">
    <div class="card-body p-0">
        @if (zamowienia.Any())
        {
            <form method="post">
                @Html.AntiForgeryToken()

                <div class="p-3 border-bottom d-flex justify-content-between align-items-center gap-2 flex-wrap zamowienie-toolbar">
                    <div class="d-flex align-items-center gap-2">
                        <input type="checkbox"
                               class="form-check-input"
                               id="zaznaczWszystkieZamowienia" />

                        <label for="zaznaczWszystkieZamowienia" class="form-check-label">
                            Zaznacz wszystko
                        </label>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit"
                                asp-action="PobierzZaznaczoneZamowieniaExcel"
                                class="btn btn-outline-success">
                            Pobierz zaznaczone Excel
                        </button>

                        <button type="submit"
                                asp-action="PobierzFakturyPdfZip"
                                class="btn btn-dark">
                            Pobierz zaznaczone faktury ZIP
                        </button>
                    </div>
                </div>

                <div class="table-responsive zamowienie-desktop-table">
                    <table class="table table-hover table-striped mb-0 crud-tabela">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 45px;"></th>
                                <th>Numer zamówienia</th>
                                <th>Źródło</th>
                                <th>Data</th>
                                <th>Status</th>
                                <th>Wartość razem</th>
                                <th>Adres</th>
                                <th>Klient</th>
                                <th class="text-end">Akcje</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in zamowienia)
                            {
                                var czyZamowienieWWW =
                                    !string.IsNullOrWhiteSpace(item.NumerZamowienia) &&
                                    item.NumerZamowienia.StartsWith("WWW", StringComparison.OrdinalIgnoreCase);

                                var nastepnyStatus = PobierzNastepnyStatus(item.Status);
                                var tekstPrzyciskuStatusu = PobierzTekstPrzyciskuStatusu(item.Status);

                                <tr class="@(czyZamowienieWWW ? "zamowienie-www-row" : string.Empty)">
                                    <td>
                                        <input type="checkbox"
                                               class="form-check-input checkbox-zamowienie"
                                               name="ids"
                                               value="@item.IdZamowienia" />
                                    </td>

                                    <td>
                                        <strong>@item.NumerZamowienia</strong>
                                    </td>

                                    <td>
                                        @if (czyZamowienieWWW)
                                        {
                                            <span class="badge bg-primary">Portal WWW</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">Intranet</span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.DataZamowienia != null)
                                        {
                                            @item.DataZamowienia.Value.ToString("dd.MM.yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">brak</span>
                                        }
                                    </td>

                                    <td>
                                        @if (czyZamowienieWWW && item.Status == "Nowe")
                                        {
                                            <span class="badge bg-success">@item.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.Status</span>
                                        }
                                    </td>

                                    <td>
                                        <strong>@item.WartoscRazem.ToString("N2")</strong>
                                    </td>

                                    <td>
                                        @item.Ulica @item.NumerDomu
                                        @if (!string.IsNullOrWhiteSpace(item.NumerLokalu))
                                        {
                                            <span>/@item.NumerLokalu</span>
                                        }
                                        <br />
                                        <small class="text-muted">@item.KodPocztowy @item.Miasto</small>
                                    </td>

                                    <td>
                                        @if (item.Klient != null)
                                        {
                                            <div>@item.Klient.Email</div>
                                            <small class="text-muted">@item.Klient.Imie @item.Klient.Nazwisko</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">brak klienta</span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            @if (!string.IsNullOrWhiteSpace(nastepnyStatus))
                                            {
                                                <button type="submit"
                                                        formaction="@Url.Action("ZmienStatus", "Zamowienie", new { id = item.IdZamowienia, status = nastepnyStatus })"
                                                        class="btn btn-outline-success">
                                                    @tekstPrzyciskuStatusu
                                                </button>
                                            }

                                            <a asp-action="PobierzFakturePdf"
                                               asp-route-id="@item.IdZamowienia"
                                               class="btn btn-outline-dark">
                                                PDF
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.IdZamowienia"
                                               class="btn btn-outline-primary">
                                                Edytuj
                                            </a>

                                            <a asp-action="Details"
                                               asp-route-id="@item.IdZamowienia"
                                               class="btn btn-outline-secondary">
                                                Szczegóły
                                            </a>

                                            @if (czyAdministrator)
                                            {
                                                <a asp-action="Delete"
                                                   asp-route-id="@item.IdZamowienia"
                                                   class="btn btn-outline-danger">
                                                    Usuń
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="zamowienie-mobile-list p-3">
                    @foreach (var item in zamowienia)
                    {
                        var czyZamowienieWWW =
                            !string.IsNullOrWhiteSpace(item.NumerZamowienia) &&
                            item.NumerZamowienia.StartsWith("WWW", StringComparison.OrdinalIgnoreCase);

                        var nastepnyStatus = PobierzNastepnyStatus(item.Status);
                        var tekstPrzyciskuStatusu = PobierzTekstPrzyciskuStatusu(item.Status);

                        <div class="zamowienie-mobile-card @(czyZamowienieWWW ? "zamowienie-mobile-card-www" : string.Empty)">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                                <div>
                                    <h2 class="h6 mb-1">@item.NumerZamowienia</h2>

                                    @if (czyZamowienieWWW)
                                    {
                                        <span class="badge bg-primary mb-2">Portal WWW</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border mb-2">Intranet</span>
                                    }

                                    @if (item.Klient != null)
                                    {
                                        <div class="small text-muted">
                                            @item.Klient.Email
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted">
                                            brak klienta
                                        </div>
                                    }
                                </div>

                                <input type="checkbox"
                                       class="form-check-input checkbox-zamowienie"
                                       name="ids"
                                       value="@item.IdZamowienia" />
                            </div>

                            <dl class="zamowienie-mobile-info">
                                <dt>Data</dt>
                                <dd>
                                    @if (item.DataZamowienia != null)
                                    {
                                        @item.DataZamowienia.Value.ToString("dd.MM.yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">brak</span>
                                    }
                                </dd>

                                <dt>Status</dt>
                                <dd>
                                    @if (czyZamowienieWWW && item.Status == "Nowe")
                                    {
                                        <span class="badge bg-success">@item.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.Status</span>
                                    }
                                </dd>

                                <dt>Wartość</dt>
                                <dd>
                                    <strong>@item.WartoscRazem.ToString("N2")</strong>
                                </dd>

                                <dt>Adres</dt>
                                <dd>
                                    @item.Ulica @item.NumerDomu
                                    @if (!string.IsNullOrWhiteSpace(item.NumerLokalu))
                                    {
                                        <span>/@item.NumerLokalu</span>
                                    }
                                    <br />
                                    <span class="text-muted">@item.KodPocztowy @item.Miasto</span>
                                </dd>

                                <dt>Klient</dt>
                                <dd>
                                    @if (item.Klient != null)
                                    {
                                        <span>@item.Klient.Imie @item.Klient.Nazwisko</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">brak</span>
                                    }
                                </dd>
                            </dl>

                            <div class="zamowienie-mobile-actions">
                                @if (!string.IsNullOrWhiteSpace(nastepnyStatus))
                                {
                                    <button type="submit"
                                            formaction="@Url.Action("ZmienStatus", "Zamowienie", new { id = item.IdZamowienia, status = nastepnyStatus })"
                                            class="btn btn-outline-success">
                                        @tekstPrzyciskuStatusu
                                    </button>
                                }

                                <a asp-action="PobierzFakturePdf"
                                   asp-route-id="@item.IdZamowienia"
                                   class="btn btn-outline-dark">
                                    PDF
                                </a>

                                <a asp-action="Details"
                                   asp-route-id="@item.IdZamowienia"
                                   class="btn btn-outline-secondary">
                                    Szczegóły
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.IdZamowienia"
                                   class="btn btn-outline-primary">
                                    Edytuj
                                </a>

                                @if (czyAdministrator)
                                {
                                    <a asp-action="Delete"
                                       asp-route-id="@item.IdZamowienia"
                                       class="btn btn-outline-danger">
                                        Usuń
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </form>
        }
        else
        {
            <div class="p-4">
                <div class="alert alert-info mb-0">
                    Brak zamówień dla wybranych filtrów.
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        const zaznaczWszystkieZamowienia = document.getElementById('zaznaczWszystkieZamowienia');

        if (zaznaczWszystkieZamowienia) {
            zaznaczWszystkieZamowienia.addEventListener('change', function () {
                const checkboxy = document.querySelectorAll('.checkbox-zamowienie');

                checkboxy.forEach(function (checkbox) {
                    checkbox.checked = zaznaczWszystkieZamowienia.checked;
                });
            });
        }
    </script>
}

@functions {
    private static string? PobierzNastepnyStatus(string? status)
    {
        var statusTekst = status?.Trim().ToLowerInvariant();

        return statusTekst switch
        {
            "nowe" => "w trakcie",
            "w trakcie" => "wysłane",
            "wyslane" => "zakończone",
            "wysłane" => "zakończone",
            _ => null
        };
    }

    private static string PobierzTekstPrzyciskuStatusu(string? status)
    {
        var statusTekst = status?.Trim().ToLowerInvariant();

        return statusTekst switch
        {
            "nowe" => "Przyjmij",
            "w trakcie" => "Wyślij",
            "wyslane" => "Zakończ",
            "wysłane" => "Zakończ",
            _ => "Zmień status"
        };
    }
}