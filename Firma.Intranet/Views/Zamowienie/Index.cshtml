@model IEnumerable<Firma.Data.Data.Sklep.Zamowienie>

@{
    ViewData["Title"] = "Zamówienia";
}

<div class="crud-naglowek">
    <div>
        <h1 class="h2 mb-1">Zamówienia</h1>
        <p class="crud-podtytul">Lista rekordów w module: zamówienia.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Dodaj nowy rekord</a>
</div>

<div class="card crud-karta">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0 crud-tabela">
                <thead class="table-light">
                    <tr>
                        <th>Numer zamówienia</th>
                        <th>Data</th>
                        <th>Status</th>
                        <th>Wartość razem</th>
                        <th>Adres</th>
                        <th>Klient</th>
                        <th>Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.NumerZamowienia</td>
                            <td>@Html.DisplayFor(modelItem => item.DataZamowienia)</td>
                            <td>@item.Status</td>
                            <td>@item.WartoscRazem</td>
                            <td>
                                @item.Ulica @item.NumerDomu
                                @if (!string.IsNullOrWhiteSpace(item.NumerLokalu))
                                {
                                    <span>/@item.NumerLokalu</span>
                                }
                                <br />
                                <small class="text-muted">@item.KodPocztowy @item.Miasto</small>
                            </td>
                            <td>@item.Klient?.Email</td>
                            <td class="crud-akcje">
                                <a asp-action="Edit" asp-route-id="@item.IdZamowienia" class="btn btn-sm btn-outline-primary">Edytuj</a>
                                <a asp-action="Details" asp-route-id="@item.IdZamowienia" class="btn btn-sm btn-outline-secondary">Szczegóły</a>
                                <a asp-action="Delete" asp-route-id="@item.IdZamowienia" class="btn btn-sm btn-outline-danger">Usuń</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>