@model Firma.Data.Data.Sklep.Zamowienie

@{
    ViewData["Title"] = "Szczegóły - Zamówienie";
}

<div class="crud-naglowek">
    <div>
        <h1 class="h2 mb-1">Szczegóły zamówienia</h1>
        <p class="crud-podtytul">Podgląd danych rekordu: zamówienie.</p>
    </div>

    <a asp-action="PobierzFakturePdf"
       asp-route-id="@Model.IdZamowienia"
       class="btn btn-dark">
        Pobierz fakturę PDF
    </a>
</div>

<div class="card crud-karta mb-4">
    <div class="card-body p-4">
        <dl class="row crud-opis mb-4">
            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.NumerZamowienia)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.NumerZamowienia)
            </dd>

            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.DataZamowienia)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @if (Model.DataZamowienia != null)
                {
                    @Model.DataZamowienia.Value.ToString("dd.MM.yyyy")
                }
                else
                {
                    <span class="text-muted">brak</span>
                }
            </dd>

            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.Status)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.Status)
            </dd>

            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.WartoscRazem)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Model.WartoscRazem.ToString("N2")
            </dd>

            <dt class="col-sm-4 col-lg-3">
                Adres dostawy
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Model.Ulica @Model.NumerDomu
                @if (!string.IsNullOrWhiteSpace(Model.NumerLokalu))
                {
                    <span>/@Model.NumerLokalu</span>
                }
                <br />
                @Model.KodPocztowy @Model.Miasto
            </dd>

            <dt class="col-sm-4 col-lg-3">
                Klient
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @if (Model.Klient != null)
                {
                    <div>@Model.Klient.Imie @Model.Klient.Nazwisko</div>
                    <div class="text-muted">@Model.Klient.Email</div>

                    @if (!string.IsNullOrWhiteSpace(Model.Klient.Telefon))
                    {
                        <div class="text-muted">@Model.Klient.Telefon</div>
                    }
                }
                else
                {
                    <span class="text-muted">brak klienta</span>
                }
            </dd>
        </dl>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="PobierzFakturePdf"
               asp-route-id="@Model.IdZamowienia"
               class="btn btn-dark">
                Pobierz fakturę PDF
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.IdZamowienia"
               class="btn btn-primary">
                Edytuj
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Powrót do listy
            </a>
        </div>
    </div>
</div>

<div class="card crud-karta">
    <div class="card-body p-4">
        <h2 class="h5 mb-3">Pozycje zamówienia</h2>

        @if (Model.PozycjaZamowienia != null && Model.PozycjaZamowienia.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Towar</th>
                            <th>Ilość</th>
                            <th>Cena jednostkowa</th>
                            <th>Wartość</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.PozycjaZamowienia.OrderBy(p => p.IdPozycjiZamowienia))
                        {
                            <tr>
                                <td>
                                    @if (item.Towar != null)
                                    {
                                        <strong>@item.Towar.Nazwa</strong>
                                        <div class="small text-muted">@item.Towar.Kod</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Towar ID: @item.IdTowaru</span>
                                    }
                                </td>

                                <td>@item.Ilosc</td>

                                <td>@item.CenaJednostkowa.ToString("N2")</td>

                                <td>
                                    <strong>@((item.Ilosc * item.CenaJednostkowa).ToString("N2"))</strong>
                                </td>
                            </tr>
                        }
                    </tbody>

                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Razem</th>
                            <th>@Model.WartoscRazem.ToString("N2")</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">
                To zamówienie nie ma jeszcze pozycji.
            </div>
        }
    </div>
</div>