@model Firma.Data.Data.Sklep.Zamowienie

@{
    ViewData["Title"] = "Szczegóły - Zamówienie";
}

<div class="crud-naglowek">
    <div>
        <h1 class="h2 mb-1">Szczegóły</h1>
        <p class="crud-podtytul">Podgląd danych rekordu: zamówienie.</p>
    </div>
</div>

<div class="card crud-karta">
    <div class="card-body p-4">
        <dl class="row crud-opis mb-4">
            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.NumerZamowienia)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.NumerZamowienia)
            </dd>
            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.DataZamowienia)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.DataZamowienia)
            </dd>
            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.Status)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.Status)
            </dd>
            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.WartoscRazem)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.WartoscRazem)
            </dd>
            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.Ulica)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.Ulica)
            </dd>
            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.NumerDomu)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.NumerDomu)
            </dd>
            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.NumerLokalu)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.NumerLokalu)
            </dd>
            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.KodPocztowy)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.KodPocztowy)
            </dd>
            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.Miasto)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.Miasto)
            </dd>
            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.Klient)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.Klient.Email)
            </dd>
        </dl>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Edit" asp-route-id="@Model?.IdZamowienia" class="btn btn-primary">Edytuj</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Powrót do listy</a>
        </div>
    </div>
</div>