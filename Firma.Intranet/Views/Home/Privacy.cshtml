@{
    ViewData["Title"] = "Polityka prywatności";
}

<div class="crud-naglowek">
    <div>
        <h1 class="h2 mb-1">Polityka prywatności</h1>
        <p class="crud-podtytul">Zasady przetwarzania danych w systemie wewnętrznym firmy.</p>
    </div>
</div>

<div class="card crud-karta">
    <div class="card-body p-4">
        <p>
            System intranetowy firmy Druk 3D jest przeznaczony do użytku wewnętrznego
            i wspiera obsługę procesów związanych z zarządzaniem treścią, towarami,
            klientami oraz zamówieniami.
        </p>

        <p>
            Dane przetwarzane w systemie są wykorzystywane wyłącznie do realizacji
            celów biznesowych firmy i nie powinny być udostępniane osobom nieuprawnionym.
        </p>

        <p class="mb-0">
            Każdy pracownik korzystający z systemu jest zobowiązany do zachowania
            poufności oraz przestrzegania zasad bezpieczeństwa danych.
        </p>
    </div>
</div>