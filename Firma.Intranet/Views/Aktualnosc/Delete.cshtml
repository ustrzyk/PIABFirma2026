@model Firma.Data.Data.CMS.Aktualnosc

@{
    ViewData["Title"] = "Usuń - Aktualność";
}

<div class="crud-naglowek">
    <div>
        <h1 class="h2 mb-1">Usuń rekord</h1>
        <p class="crud-podtytul">Przed usunięciem sprawdź, czy wybrany rekord jest poprawny.</p>
    </div>
</div>

<div class="card crud-karta border-danger-subtle">
    <div class="card-body p-4">
        <div class="alert alert-warning" role="alert">
            Czy na pewno chcesz usunąć tę aktualność?
        </div>

        <dl class="row crud-opis mb-4">
            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.LinkTytul)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.LinkTytul)
            </dd>

            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.Tytul)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.Tytul)
            </dd>

            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.Tresc)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.Tresc)
            </dd>

            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.Pozycja)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.Pozycja)
            </dd>

            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.CzyAktywny)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @if (Model.CzyAktywny)
                {
                    <span class="badge bg-success">tak</span>
                }
                else
                {
                    <span class="badge bg-secondary">nie</span>
                }
            </dd>
        </dl>

        <form asp-action="Delete" class="d-flex gap-2 flex-wrap">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="IdAktualnosci" />

            <input type="submit"
                   value="Usuń rekord"
                   class="btn btn-danger" />

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Anuluj
            </a>
        </form>
    </div>
</div>