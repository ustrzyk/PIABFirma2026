@model Firma.Intranet.Models.UzytkownikCreateViewModel

@{
    ViewData["Title"] = "Dodaj użytkownika";
}

<div class="crud-naglowek">
    <div>
        <h1 class="h2 mb-1">Dodaj użytkownika</h1>
        <p class="crud-podtytul">Tworzenie konta do panelu Intranet.</p>
    </div>
</div>

<div class="card crud-karta">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Haslo" class="form-label"></label>
                <input asp-for="Haslo" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Haslo" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Rola" class="form-label"></label>
                <select asp-for="Rola"
                        asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.DostepneRole))"
                        class="form-select">
                </select>
                <span asp-validation-for="Rola" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-primary">
                    Zapisz
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Powrót do listy
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}