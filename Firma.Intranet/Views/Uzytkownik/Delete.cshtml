@model Firma.Intranet.Models.UsunUzytkownikaViewModel

@{
    ViewData["Title"] = "Usuń użytkownika";
}

<div class="crud-naglowek">
    <div>
        <h1 class="h2 mb-1">Usuń użytkownika</h1>
        <p class="crud-podtytul">Potwierdzenie usunięcia konta.</p>
    </div>
</div>

<div class="card crud-karta">
    <div class="card-body p-4">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        @if (Model.CzyAktualnieZalogowany)
        {
            <div class="alert alert-warning">
                Nie można usunąć aktualnie zalogowanego użytkownika.
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                Czy na pewno chcesz usunąć tego użytkownika?
            </div>
        }

        <dl class="row crud-opis mb-4">
            <dt class="col-sm-4 col-lg-3">E-mail</dt>
            <dd class="col-sm-8 col-lg-9">@Model.Email</dd>

            <dt class="col-sm-4 col-lg-3">Role</dt>
            <dd class="col-sm-8 col-lg-9">
                @if (Model.Role.Any())
                {
                    foreach (var rola in Model.Role)
                    {
                        <span class="badge bg-secondary me-1">
                            @rola
                        </span>
                    }
                }
                else
                {
                    <span class="text-muted">brak roli</span>
                }
            </dd>
        </dl>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div class="d-flex gap-2 flex-wrap">
                @if (!Model.CzyAktualnieZalogowany)
                {
                    <button type="submit" class="btn btn-danger">
                        Usuń
                    </button>
                }

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Powrót do listy
                </a>
            </div>
        </form>
    </div>
</div>