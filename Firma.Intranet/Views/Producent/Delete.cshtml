@model Firma.Data.Data.Sklep.Producent

@{
    ViewData["Title"] = "Usuń - Producent";
}

<div class="crud-naglowek">
    <div>
        <h1 class="h2 mb-1">Usuń rekord</h1>
        <p class="crud-podtytul">Przed usunięciem sprawdź, czy wybrany rekord jest poprawny.</p>
    </div>
</div>

<div class="card crud-karta border-danger-subtle">
    <div class="card-body p-4">
        @if (Model.Towar != null && Model.Towar.Any())
        {
            <div class="alert alert-warning" role="alert">
                Ten producent ma przypisane towary. Po potwierdzeniu zostanie dezaktywowany.
            </div>
        }
        else
        {
            <div class="alert alert-warning" role="alert">
                Czy na pewno chcesz usunąć tego producenta?
            </div>
        }

        <dl class="row crud-opis mb-4">
            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.Nazwa)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.Nazwa)
            </dd>

            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.Kraj)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @if (!string.IsNullOrWhiteSpace(Model.Kraj))
                {
                    @Model.Kraj
                }
                else
                {
                    <span class="text-muted">brak</span>
                }
            </dd>

            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.StronaWWW)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @if (!string.IsNullOrWhiteSpace(Model.StronaWWW))
                {
                    @Model.StronaWWW
                }
                else
                {
                    <span class="text-muted">brak</span>
                }
            </dd>

            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.Opis)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @if (!string.IsNullOrWhiteSpace(Model.Opis))
                {
                    @Model.Opis
                }
                else
                {
                    <span class="text-muted">brak</span>
                }
            </dd>

            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.CzyAktywny)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @if (Model.CzyAktywny)
                {
                    <span class="badge bg-success">tak</span>
                }
                else
                {
                    <span class="badge bg-secondary">nie</span>
                }
            </dd>
        </dl>

        <form asp-action="Delete" class="d-flex gap-2 flex-wrap">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="IdProducenta" />

            <input type="submit"
                   value="Potwierdź"
                   class="btn btn-danger" />

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Anuluj
            </a>
        </form>
    </div>
</div>