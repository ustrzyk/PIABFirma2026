@model IEnumerable<Firma.Data.Data.Sklep.Klient>

@{
    ViewData["Title"] = "Klienci";
}

<div class="crud-naglowek">
    <div>
        <h1 class="h2 mb-1">Klienci</h1>
        <p class="crud-podtytul">Lista rekordów w module: klienci.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Dodaj nowy rekord</a>
</div>

<div class="card crud-karta">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0 crud-tabela">
                <thead class="table-light">
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Imie)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Nazwisko)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Email)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Telefon)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Imie)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Nazwisko)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Email)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Telefon)
                            </td>
                            <td class="crud-akcje">
                                <a asp-action="Edit" asp-route-id="@item.IdKlienta" class="btn btn-sm btn-outline-primary">Edytuj</a>
                                <a asp-action="Details" asp-route-id="@item.IdKlienta" class="btn btn-sm btn-outline-secondary">Szczegóły</a>
                                <a asp-action="Delete" asp-route-id="@item.IdKlienta" class="btn btn-sm btn-outline-danger">Usuń</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>