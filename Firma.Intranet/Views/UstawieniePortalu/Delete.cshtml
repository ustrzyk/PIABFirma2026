@model Firma.Data.Data.CMS.UstawieniePortalu

@{
    ViewData["Title"] = "Usuń - Ustawienie portalu";
}

<div class="crud-naglowek">
    <div>
        <h1 class="h2 mb-1">Usuń rekord</h1>
        <p class="crud-podtytul">Przed usunięciem sprawdź, czy wybrany rekord jest poprawny.</p>
    </div>
</div>

<div class="card crud-karta border-danger-subtle">
    <div class="card-body p-4">
        <div class="alert alert-warning" role="alert">
            Czy na pewno chcesz usunąć to ustawienie portalu?
        </div>

        <dl class="row crud-opis mb-4">
            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.Klucz)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.Klucz)
            </dd>

            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.Wartosc)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.Wartosc)
            </dd>

            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.Opis)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @if (!string.IsNullOrWhiteSpace(Model.Opis))
                {
                    @Model.Opis
                }
                else
                {
                    <span class="text-muted">brak</span>
                }
            </dd>

            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.CzyAktywny)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @if (Model.CzyAktywny)
                {
                    <span class="badge bg-success">tak</span>
                }
                else
                {
                    <span class="badge bg-secondary">nie</span>
                }
            </dd>
        </dl>

        <form asp-action="Delete" class="d-flex gap-2 flex-wrap">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="IdUstawieniaPortalu" />

            <input type="submit"
                   value="Usuń rekord"
                   class="btn btn-danger" />

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Anuluj
            </a>
        </form>
    </div>
</div>