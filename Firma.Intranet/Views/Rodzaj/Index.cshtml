@model IEnumerable<Firma.Data.Data.Sklep.Rodzaj>

@{
    ViewData["Title"] = "Rodzaje";
    var czyAdministrator = User.IsInRole("Administrator");
}

<div class="crud-naglowek">
    <div>
        <h1 class="h2 mb-1">Rodzaje</h1>
        <p class="crud-podtytul">Lista rekordów w module: rodzaje.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Dodaj nowy rekord
    </a>
</div>

<div class="card crud-karta">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 crud-tabela">
                    <thead class="table-light">
                        <tr>
                            <th>Nazwa rodzaju</th>
                            <th>Opis</th>
                            <th>Aktywny</th>
                            <th class="text-end">Akcje</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Nazwa</strong>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Opis))
                                    {
                                        @item.Opis
                                    }
                                    else
                                    {
                                        <span class="text-muted">brak</span>
                                    }
                                </td>

                                <td>
                                    @if (item.CzyAktywny)
                                    {
                                        <span class="badge bg-success">tak</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">nie</span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1 flex-wrap">
                                        <a asp-action="Edit"
                                           asp-route-id="@item.IdRodzaju"
                                           class="btn btn-sm btn-outline-primary">
                                            Edytuj
                                        </a>

                                        <a asp-action="Details"
                                           asp-route-id="@item.IdRodzaju"
                                           class="btn btn-sm btn-outline-secondary">
                                            Szczegóły
                                        </a>

                                        @if (czyAdministrator)
                                        {
                                            @if (item.CzyAktywny)
                                            {
                                                <form asp-action="Dezaktywuj"
                                                      asp-route-id="@item.IdRodzaju"
                                                      method="post"
                                                      class="d-inline">
                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-warning">
                                                        Dezaktywuj
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Aktywuj"
                                                      asp-route-id="@item.IdRodzaju"
                                                      method="post"
                                                      class="d-inline">
                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success">
                                                        Aktywuj
                                                    </button>
                                                </form>
                                            }

                                            <a asp-action="Delete"
                                               asp-route-id="@item.IdRodzaju"
                                               class="btn btn-sm btn-outline-danger">
                                                Usuń
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-4">
                <div class="alert alert-info mb-0">
                    Brak rodzajów do wyświetlenia.
                </div>
            </div>
        }
    </div>
</div>