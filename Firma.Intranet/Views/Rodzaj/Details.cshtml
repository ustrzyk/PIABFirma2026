@model Rodzaj

@{
    ViewData["Title"] = "Szczegóły - Rodzaj";
}

<div class="crud-naglowek">
    <div>
        <h1 class="h2 mb-1">Szczegóły</h1>
        <p class="crud-podtytul">Podgląd danych rekordu: rodzaj.</p>
    </div>
</div>

<div class="card crud-karta">
    <div class="card-body p-4">
        <dl class="row crud-opis mb-4">
            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.Nazwa)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.Nazwa)
            </dd>
            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.Opis)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.Opis)
            </dd>
        </dl>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Edit" asp-route-id="@Model?.IdRodzaju" class="btn btn-primary">Edytuj</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Powrót do listy</a>
        </div>
    </div>
</div>