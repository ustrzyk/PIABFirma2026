@model Towar

@{
    ViewData["Title"] = "Dodaj towar";
}

<div class="crud-naglowek">
    <div>
        <h1 class="h2 mb-1">Dodaj towar</h1>
        <p class="crud-podtytul">Formularz pozwala zapisać dane w module: towary.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="card crud-karta">
            <div class="card-body p-4">
                <form asp-action="Create" class="crud-form">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Kod" class="form-label"></label>
                        <input asp-for="Kod" class="form-control" />
                        <span asp-validation-for="Kod" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Nazwa" class="form-label"></label>
                        <input asp-for="Nazwa" class="form-control" />
                        <span asp-validation-for="Nazwa" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Cena" class="form-label"></label>
                        <input asp-for="Cena" class="form-control kwota-input" type="text" inputmode="decimal" asp-format="{0:0.00}" placeholder="np. 1299,99" />
                        <span asp-validation-for="Cena" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FotoUrl" class="form-label"></label>
                        <input asp-for="FotoUrl" class="form-control" />
                        <span asp-validation-for="FotoUrl" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Opis" class="form-label"></label>
                        <textarea asp-for="Opis" class="form-control" rows="5"></textarea>
                        <span asp-validation-for="Opis" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="IdRodzaju" class="form-label"></label>
                        <select asp-for="IdRodzaju" class="form-select" asp-items="ViewBag.IdRodzaju"></select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="IdProducenta" class="form-label"></label>
                        <select asp-for="IdProducenta" class="form-select" asp-items="ViewBag.IdProducenta"></select>
                    </div>

                    <div class="mb-3 form-check">
                        <input class="form-check-input" asp-for="CzyAktywny" />
                        <label class="form-check-label" asp-for="CzyAktywny"></label>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex gap-2 pt-2">
                            <input type="submit" value="Zapisz" class="btn btn-primary" />
                            <a asp-action="Index" class="btn btn-outline-secondary">Powrót do listy</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}