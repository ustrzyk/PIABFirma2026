@model Firma.Data.Data.Sklep.StanMagazynowy

@{
    ViewData["Title"] = "Usuń - Stan magazynowy";
}

<div class="crud-naglowek">
    <div>
        <h1 class="h2 mb-1">Usuń rekord</h1>
        <p class="crud-podtytul">Przed usunięciem sprawdź, czy wybrany rekord jest poprawny.</p>
    </div>
</div>

<div class="card crud-karta border-danger-subtle">
    <div class="card-body p-4">
        <div class="alert alert-warning" role="alert">
            Czy na pewno chcesz usunąć ten rekord?
        </div>

        <dl class="row crud-opis mb-4">
            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.IloscSztuk)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.IloscSztuk)
            </dd>

            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.MinimalnaIlosc)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.MinimalnaIlosc)
            </dd>

            <dt class="col-sm-4 col-lg-3">
                @Html.DisplayNameFor(model => model.Lokalizacja)
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @Html.DisplayFor(model => model.Lokalizacja)
            </dd>

            <dt class="col-sm-4 col-lg-3">
                Towar
            </dt>
            <dd class="col-sm-8 col-lg-9 tekst-wielowierszowy">
                @if (Model.Towar != null)
                {
                    @Model.Towar.Nazwa
                }
                else
                {
                    <span class="text-muted">brak towaru</span>
                }
            </dd>
        </dl>

        <form asp-action="Delete" class="d-flex gap-2 flex-wrap">
            <input type="hidden" asp-for="IdStanuMagazynowego" />

            <input type="submit"
                   value="Usuń rekord"
                   class="btn btn-danger" />

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Anuluj
            </a>
        </form>
    </div>
</div>