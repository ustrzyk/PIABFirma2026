@model Firma.Data.Data.CMS.Strona

@{
    ViewData["Title"] = Model != null ? Model.LinkTytul : "Strona główna";
}

@if (Model != null)
{
    <div class="portal-header mb-4">
        <div>
            <span class="portal-badge">Portal klienta</span>
            <h1 class="h2 mt-2 mb-1">@Model.Tytul</h1>
            <p class="text-muted mb-0">
                Treść strony jest zarządzana w panelu Intranet.
            </p>
        </div>

        <div class="mt-3 mt-md-0 d-flex gap-2 flex-wrap">
            <a class="btn btn-primary" asp-controller="Sklep" asp-action="Index">
                Przejdź do sklepu
            </a>
            <a class="btn btn-outline-secondary" asp-controller="Promocja" asp-action="Index">
                Promocje
            </a>
        </div>
    </div>

    <div class="card page-card">
        <div class="card-body p-4">
            <div class="tekst-strony">
                @Model.Tresc
            </div>
        </div>
    </div>

    <div class="small text-muted mt-3">
        Data i godzina wejścia: @DateTime.Now.ToString("dd.MM.yyyy HH:mm")
    </div>
}
else
{
    <div class="alert alert-warning">
        Brak strony do wyświetlenia. Dodaj aktywny rekord w Intranecie w tabeli Strona.
    </div>
}
