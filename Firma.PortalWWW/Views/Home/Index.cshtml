@model Firma.Services.Data.Dto.CMS.StronaSzczegolyDto

@{
    ViewData["Title"] = Model != null ? Model.LinkTytul : "Strona główna";
}

@if (Model != null)
{
    <div class="portal-header portal-header-responsive mb-4">
        <div>
            <span class="portal-badge">Portal klienta</span>
            <h1 class="h3 mt-2 mb-1">@Model.Tytul</h1>
            <p class="text-muted mb-0">
                Treść strony jest zarządzana w panelu Intranet.
            </p>
        </div>

        <div class="portal-actions">
            <a asp-controller="Sklep"
               asp-action="Index"
               class="btn btn-primary">
                Przejdź do sklepu
            </a>

            <a asp-controller="Promocja"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Promocje
            </a>
        </div>
    </div>

    <div class="card page-card shadow-sm">
        <div class="card-body p-4">
            <div class="tekst-strony">
                @Model.Tresc
            </div>

            <hr />

            <p class="text-muted small mb-0">
                Data i godzina wejścia: @DateTime.Now.ToString("dd.MM.yyyy HH:mm")
            </p>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">
        Brak strony do wyświetlenia. Dodaj aktywny rekord w Intranecie w tabeli Strona.
    </div>
}