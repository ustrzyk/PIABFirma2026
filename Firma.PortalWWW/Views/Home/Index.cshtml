@model Firma.Services.Data.Dto.CMS.StronaSzczegolyDto

@{
    ViewData["Title"] = Model != null ? Model.LinkTytul : "Strona główna";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

@if (Model != null)
{
    <section class="home-hero mb-4">
        <div class="home-hero-content">
            <span class="portal-badge">Sklep 3D</span>

            <h1>
                @Model.Tytul
            </h1>

            <div class="home-hero-text tekst-strony">
                @Model.Tresc
            </div>

            <div class="home-hero-actions">
                <a href="/Sklep/Index"
                   class="btn btn-primary btn-lg">
                    <span class="btn-icon">🛒</span>
                    Przejdź do sklepu
                </a>

                <a asp-controller="StatusZamowienia"
                   asp-action="Index"
                   class="btn btn-outline-secondary btn-lg">
                    <span class="btn-icon">🧾</span>
                    Sprawdź zamówienie
                </a>
            </div>
        </div>

        <div class="home-hero-panel">
            <div class="hero-card-title">Jak kupić?</div>

            <div class="home-step">
                <span>1</span>
                <div>
                    <strong>Wybierz produkt</strong>
                    <p>Przejdź do sklepu i wybierz drukarkę, filament lub akcesoria.</p>
                </div>
            </div>

            <div class="home-step">
                <span>2</span>
                <div>
                    <strong>Dodaj do koszyka</strong>
                    <p>Ustaw ilość, sprawdź dostępność i potwierdź zamówienie.</p>
                </div>
            </div>

            <div class="home-step">
                <span>3</span>
                <div>
                    <strong>Sprawdź status</strong>
                    <p>Po zakupie użyj numeru zamówienia i adresu e-mail.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="home-quick-grid mb-4">
        <a href="/Sklep/Index" class="home-quick-card">
            <span class="home-quick-icon">🧩</span>
            <span class="home-quick-number">01</span>
            <h2>Produkty</h2>
            <p>Pełna oferta sklepu z cenami, opisami i dostępnością.</p>
        </a>

        <a asp-controller="Promocja"
           asp-action="Index"
           class="home-quick-card">
            <span class="home-quick-icon">🏷️</span>
            <span class="home-quick-number">02</span>
            <h2>Promocje</h2>
            <p>Aktywne oferty specjalne i rabaty.</p>
        </a>

        <a asp-controller="Producent"
           asp-action="Index"
           class="home-quick-card">
            <span class="home-quick-icon">🏭</span>
            <span class="home-quick-number">03</span>
            <h2>Producenci</h2>
            <p>Marki i produkty dostępne w portalu.</p>
        </a>

        <a asp-controller="StatusZamowienia"
           asp-action="Index"
           class="home-quick-card home-quick-card-accent">
            <span class="home-quick-icon">🧾</span>
            <span class="home-quick-number">04</span>
            <h2>Status zamówienia</h2>
            <p>Sprawdź zamówienie po numerze i adresie e-mail.</p>
        </a>
    </section>
}
else
{
    <div class="empty-state">
        <span class="portal-badge">Strona główna</span>
        <h1 class="h4 mt-3">Strona główna jest chwilowo niedostępna</h1>
        <p>Możesz przejść bezpośrednio do oferty sklepu albo sprawdzić aktualne promocje.</p>

        <div class="empty-state-actions">
            <a href="/Sklep/Index"
               class="btn btn-primary">
                Przejdź do sklepu
            </a>

            <a asp-controller="Promocja"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Zobacz promocje
            </a>
        </div>
    </div>
}