@model Firma.Services.Data.Dto.CMS.StronaSzczegolyDto

@{
    ViewData["Title"] = Model != null ? Model.LinkTytul : "Strona główna";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

@if (Model != null)
{
    <section class="portal-hero mb-4">
        <div class="row g-4 align-items-center">
            <div class="col-12 col-lg-7">
                <div class="hero-content">
                    <span class="portal-badge">Sklep 3D</span>

                    <h1 class="display-6 fw-bold mt-3 mb-3">
                        @Model.Tytul
                    </h1>

                    <div class="hero-text tekst-strony">
                        @Model.Tresc
                    </div>

                    <div class="hero-actions">
                        <a href="/Sklep/Index"
                           class="btn btn-primary btn-lg">
                            Przejdź do sklepu
                        </a>

                        <a asp-controller="Promocja"
                           asp-action="Index"
                           class="btn btn-outline-secondary btn-lg">
                            Sprawdź promocje
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="hero-card">
                    <div class="hero-card-title">Oferta portalu</div>

                    <div class="hero-feature">
                        <strong>Drukarki 3D</strong>
                        <span>Modele do domu, szkoły i firmy.</span>
                    </div>

                    <div class="hero-feature">
                        <strong>Akcesoria</strong>
                        <span>Części, dysze, stoły robocze i narzędzia.</span>
                    </div>

                    <div class="hero-feature">
                        <strong>Materiały</strong>
                        <span>Produkty dobrane pod druk i serwis.</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="info-tile">
                <span class="info-tile-number">01</span>
                <h2 class="h5">Produkty</h2>
                <p>Przejrzysta lista towarów z ceną, producentem i dostępnością.</p>
                <a href="/Sklep/Index">Zobacz sklep</a>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="info-tile">
                <span class="info-tile-number">02</span>
                <h2 class="h5">Kategorie</h2>
                <p>Szybkie przejście do wybranego rodzaju produktów.</p>
                <a href="/Sklep/Index">Przeglądaj kategorie</a>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="info-tile">
                <span class="info-tile-number">03</span>
                <h2 class="h5">Promocje</h2>
                <p>Osobna sekcja z aktywnymi ofertami specjalnymi.</p>
                <a asp-controller="Promocja" asp-action="Index">Zobacz promocje</a>
            </div>
        </div>
    </section>
}
else
{
    <div class="empty-state">
        <span class="portal-badge">Strona główna</span>
        <h1 class="h4 mt-3">Strona główna jest chwilowo niedostępna</h1>
        <p>Możesz przejść bezpośrednio do oferty sklepu albo sprawdzić aktualne promocje.</p>

        <div class="empty-state-actions">
            <a href="/Sklep/Index"
               class="btn btn-primary">
                Przejdź do sklepu
            </a>

            <a asp-controller="Promocja"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Zobacz promocje
            </a>
        </div>
    </div>
}