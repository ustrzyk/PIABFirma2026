@{
    ViewData["Title"] = "Prywatność";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

<section class="portal-hero mb-4">
    <div class="row g-4 align-items-center">
        <div class="col-12 col-lg-8">
            <span class="portal-badge">🔒 Informacje</span>

            <h1 class="display-6 fw-bold mt-3 mb-3">
                Prywatność
            </h1>

            <p class="hero-text mb-0">
                Proste informacje o danych widocznych w publicznej części portalu.
            </p>

            <div class="hero-actions">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-primary btn-lg">
                    Strona główna
                </a>

                <a href="/Sklep/Index"
                   class="btn btn-outline-secondary btn-lg">
                    Przejdź do sklepu
                </a>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="hero-card">
                <div class="hero-card-title">Portal</div>

                <div class="hero-feature">
                    <strong>Oferta</strong>
                    <span>Portal prezentuje aktywne produkty, promocje i informacje.</span>
                </div>

                <div class="hero-feature">
                    <strong>Zamówienia</strong>
                    <span>Status można sprawdzić po numerze zamówienia i adresie e-mail.</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="privacy-grid">
    <article class="privacy-card">
        <span class="home-quick-icon">🧩</span>

        <h2 class="h5 mb-2">
            Dane oferty
        </h2>

        <p>
            Portal publiczny pokazuje aktywne produkty, producentów, kategorie,
            promocje, dostępność, aktualności oraz strony informacyjne.
        </p>
    </article>

    <article class="privacy-card">
        <span class="home-quick-icon">🛒</span>

        <h2 class="h5 mb-2">
            Dane zamówienia
        </h2>

        <p>
            Przy składaniu zamówienia klient podaje dane kontaktowe i adres dostawy.
            Zamówienie trafia do panelu Intranet.
        </p>
    </article>

    <article class="privacy-card">
        <span class="home-quick-icon">🧾</span>

        <h2 class="h5 mb-2">
            Status zamówienia
        </h2>

        <p>
            Status zamówienia można sprawdzić tylko po podaniu numeru zamówienia
            oraz adresu e-mail użytego przy zakupie.
        </p>
    </article>

    <article class="privacy-card">
        <span class="home-quick-icon">🔐</span>

        <h2 class="h5 mb-2">
            Panel administracyjny
        </h2>

        <p>
            Zarządzanie produktami, zamówieniami i treściami jest dostępne wyłącznie
            w zabezpieczonym panelu Intranet.
        </p>
    </article>
</section>