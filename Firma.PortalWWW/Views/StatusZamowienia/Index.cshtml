@using Firma.Services.Data.Dto.ZamowieniaPubliczne
@model Firma.PortalWWW.Models.StatusZamowieniaViewModel

@{
    ViewData["Title"] = "Status zamówienia";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";

    var wynik = Model.Wynik;
    var pozycje = wynik?.Pozycje?.ToList() ?? new List<StatusZamowieniaPozycjaDto>();

    var czyPokazanoZamowienie = wynik != null;
    var czyAnulowane = wynik?.Status == "anulowane";
}

@functions {
    private static int NumerEtapu(string? status)
    {
        var tekst = (status ?? string.Empty).Trim().ToLowerInvariant();

        if (tekst == "nowe")
        {
            return 1;
        }

        if (tekst == "w trakcie")
        {
            return 2;
        }

        if (tekst == "wysłane" || tekst == "wyslane")
        {
            return 3;
        }

        if (tekst == "zakończone" || tekst == "zakonczone")
        {
            return 4;
        }

        if (tekst == "anulowane")
        {
            return -1;
        }

        return 0;
    }

    private static string KlasaEtapu(int numer, int aktywnyEtap)
    {
        if (aktywnyEtap == -1)
        {
            return "order-step is-cancelled";
        }

        if (numer < aktywnyEtap)
        {
            return "order-step is-done";
        }

        if (numer == aktywnyEtap)
        {
            return "order-step is-current";
        }

        return "order-step";
    }
}

<section class="client-portal-hero mb-4">
    <div class="row g-4 align-items-center">
        <div class="col-12 col-lg-8">
            <span class="portal-badge">Status zamówienia</span>

            <h1 class="display-6 fw-bold mt-3 mb-3">
                Sprawdź zamówienie bez logowania
            </h1>

            <p class="hero-text mb-0">
                Ta strona jest dla klienta, który chce sprawdzić zamówienie bez logowania.
                Zalogowany klient widzi statusy w zakładce „Moje konto”.
            </p>

            <div class="hero-actions">
                <button form="formularz-statusu-zamowienia"
                        type="submit"
                        class="btn btn-primary btn-lg">
                    Sprawdź status
                </button>

                <a asp-controller="KontoKlienta"
                   asp-action="Panel"
                   class="btn btn-outline-secondary btn-lg">
                    Moje konto
                </a>

                <a href="/Sklep/Index"
                   class="btn btn-outline-secondary btn-lg">
                    Wróć do sklepu
                </a>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="client-login-card">
                <strong>Potrzebne dane</strong>

                <div>
                    <span>🧾</span>
                    <p>Numer zamówienia.</p>
                </div>

                <div>
                    <span>✉️</span>
                    <p>E-mail użyty przy zamówieniu.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@if (TempData["KomunikatKontaKlienta"] != null)
{
    <div class="alert alert-info">
        @TempData["KomunikatKontaKlienta"]
    </div>
}

<section class="checkout-page-layout">
    <div class="checkout-main-column">
        <div class="details-card mb-4">
            <div class="account-section-header">
                <div>
                    <span class="portal-badge">Formularz</span>

                    <h2 class="h5 mt-2 mb-0">
                        Dane zamówienia
                    </h2>
                </div>
            </div>

            <form id="formularz-statusu-zamowienia"
                  asp-controller="StatusZamowienia"
                  asp-action="Index"
                  method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="profile-form-grid">
                    <div>
                        <label asp-for="NumerZamowienia" class="form-label"></label>
                        <input asp-for="NumerZamowienia"
                               class="form-control"
                               placeholder="np. WWW-20260618-001" />
                        <span asp-validation-for="NumerZamowienia" class="text-danger"></span>
                    </div>

                    <div>
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email"
                               class="form-control"
                               placeholder="np. jan.kowalski@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="checkout-actions">
                    <button type="submit" class="btn btn-primary">
                        Sprawdź status
                    </button>

                    <a asp-controller="KontoKlienta"
                       asp-action="Logowanie"
                       class="btn btn-outline-secondary">
                        Zaloguj do konta
                    </a>
                </div>
            </form>
        </div>

        @if (czyPokazanoZamowienie && wynik != null)
        {
            var etap = NumerEtapu(wynik.Status);

            <div class="details-card mb-4">
                <div class="account-section-header">
                    <div>
                        <span class="portal-badge">Wynik</span>

                        <h2 class="h5 mt-2 mb-0">
                            Zamówienie @wynik.NumerZamowienia
                        </h2>
                    </div>

                    @if (czyAnulowane)
                    {
                        <span class="availability-badge unavailable">@wynik.Status</span>
                    }
                    else
                    {
                        <span class="availability-badge available">@wynik.Status</span>
                    }
                </div>

                <section class="order-detail-summary-grid mb-4">
                    <article class="account-summary-card">
                        <span class="account-summary-label">Numer</span>
                        <strong>@wynik.NumerZamowienia</strong>
                        <p>Numer zamówienia.</p>
                    </article>

                    <article class="account-summary-card">
                        <span class="account-summary-label">Data</span>

                        @if (wynik.DataZamowienia != null)
                        {
                            <strong>@wynik.DataZamowienia.Value.ToString("dd.MM.yyyy")</strong>
                        }
                        else
                        {
                            <strong>brak</strong>
                        }

                        <p>Data złożenia.</p>
                    </article>

                    <article class="account-summary-card">
                        <span class="account-summary-label">Wartość</span>
                        <strong>@wynik.WartoscRazem.ToString("C")</strong>
                        <p>Wartość zamówienia.</p>
                    </article>

                    <article class="account-summary-card">
                        <span class="account-summary-label">Status</span>
                        <strong>@wynik.Status</strong>
                        <p>Aktualny status.</p>
                    </article>
                </section>

                <div class="order-progress">
                    <div class="@KlasaEtapu(1, etap)">
                        <span>1</span>
                        <strong>Nowe</strong>
                        <small>Przyjęte</small>
                    </div>

                    <div class="@KlasaEtapu(2, etap)">
                        <span>2</span>
                        <strong>W trakcie</strong>
                        <small>Obsługa</small>
                    </div>

                    <div class="@KlasaEtapu(3, etap)">
                        <span>3</span>
                        <strong>Wysłane</strong>
                        <small>Dostawa</small>
                    </div>

                    <div class="@KlasaEtapu(4, etap)">
                        <span>4</span>
                        <strong>Zakończone</strong>
                        <small>Koniec</small>
                    </div>
                </div>
            </div>

            <div class="details-card">
                <div class="account-section-header">
                    <div>
                        <span class="portal-badge">Produkty</span>

                        <h2 class="h5 mt-2 mb-0">
                            Pozycje zamówienia
                        </h2>
                    </div>
                </div>

                @if (pozycje.Any())
                {
                    <div class="client-order-items">
                        <div class="client-order-row client-order-header">
                            <div>Produkt</div>
                            <div>Ilość</div>
                            <div>Cena</div>
                            <div>Wartość</div>
                        </div>

                        @foreach (var item in pozycje)
                        {
                            <div class="client-order-row">
                                <div class="client-order-product">
                                    <strong>@item.NazwaTowaru</strong>

                                    @if (!string.IsNullOrWhiteSpace(item.KodTowaru))
                                    {
                                        <span>@item.KodTowaru</span>
                                    }
                                </div>

                                <div>
                                    <span class="client-order-label">Ilość</span>
                                    @item.Ilosc
                                </div>

                                <div>
                                    <span class="client-order-label">Cena</span>
                                    @item.CenaJednostkowa.ToString("C")
                                </div>

                                <div>
                                    <span class="client-order-label">Wartość</span>
                                    <strong>@item.Wartosc.ToString("C")</strong>
                                </div>
                            </div>
                        }

                        <div class="client-order-total">
                            <span>Razem</span>
                            <strong>@wynik.WartoscRazem.ToString("C")</strong>
                        </div>
                    </div>
                }
                else
                {
                    <div class="empty-state empty-state-small">
                        Brak pozycji zamówienia.
                    </div>
                }
            </div>
        }
    </div>

    <aside class="checkout-sidebar-column">
        <div class="details-card mb-4">
            <div class="account-section-header">
                <div>
                    <span class="portal-badge">Wyjaśnienie</span>

                    <h2 class="h5 mt-2 mb-0">
                        Po co ta strona?
                    </h2>
                </div>
            </div>

            <div class="simple-note">
                <strong>Status bez logowania</strong>
                <span>
                    Ta strona jest przydatna dla klienta, który złożył zamówienie bez konta.
                    Jeśli klient ma konto, status znajdzie w „Moje konto”.
                </span>
            </div>
        </div>

        @if (czyPokazanoZamowienie && wynik != null)
        {
            <div class="details-card mb-4">
                <div class="account-section-header">
                    <div>
                        <span class="portal-badge">Klient</span>

                        <h2 class="h5 mt-2 mb-0">
                            Dane zamówienia
                        </h2>
                    </div>
                </div>

                <dl class="details-list-clean mb-0">
                    <dt>Klient</dt>
                    <dd>@wynik.ImieNazwisko</dd>

                    <dt>E-mail</dt>
                    <dd>@wynik.Email</dd>

                    <dt>Telefon</dt>
                    <dd>
                        @if (!string.IsNullOrWhiteSpace(wynik.Telefon))
                        {
                            @wynik.Telefon
                        }
                        else
                        {
                            <span class="text-muted">brak</span>
                        }
                    </dd>

                    <dt>Adres dostawy</dt>
                    <dd>
                        @if (!string.IsNullOrWhiteSpace(wynik.AdresDostawy))
                        {
                            @wynik.AdresDostawy
                        }
                        else
                        {
                            <span class="text-muted">brak danych</span>
                        }
                    </dd>
                </dl>
            </div>
        }

        <div class="details-card">
            <div class="account-section-header">
                <div>
                    <span class="portal-badge">Moje konto</span>

                    <h2 class="h5 mt-2 mb-0">
                        Status w koncie
                    </h2>
                </div>
            </div>

            <div class="order-detail-actions">
                <a asp-controller="KontoKlienta"
                   asp-action="Panel"
                   class="btn btn-primary w-100">
                    Moje konto
                </a>

                <a asp-controller="KontoKlienta"
                   asp-action="Logowanie"
                   class="btn btn-outline-secondary w-100">
                    Logowanie
                </a>

                <a href="/Sklep/Index"
                   class="btn btn-outline-secondary w-100">
                    Wróć do sklepu
                </a>
            </div>
        </div>
    </aside>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}