@model Firma.PortalWWW.Models.StatusZamowieniaViewModel

@{
    ViewData["Title"] = "Status zamówienia";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

<section class="portal-hero mb-4">
    <div class="row g-4 align-items-center">
        <div class="col-12 col-lg-8">
            <span class="portal-badge">🧾 Portal klienta</span>

            <h1 class="display-6 fw-bold mt-3 mb-3">
                Sprawdź status zamówienia
            </h1>

            <p class="hero-text mb-0">
                Wpisz numer zamówienia oraz adres e-mail użyty podczas składania zamówienia.
            </p>
        </div>

        <div class="col-12 col-lg-4">
            <div class="hero-card">
                <div class="hero-card-title">Co przygotować?</div>

                <div class="hero-feature">
                    <strong>Numer zamówienia</strong>
                    <span>Na przykład WWW-20260616-001 albo WWW-DEMO-001.</span>
                </div>

                <div class="hero-feature">
                    <strong>E-mail</strong>
                    <span>Ten sam adres, który był podany w formularzu zamówienia.</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="status-instruction-grid mb-4">
    <div class="simple-note">
        <strong>1. Numer zamówienia</strong>
        <span>Zobaczysz go po złożeniu zamówienia.</span>
    </div>

    <div class="simple-note">
        <strong>2. E-mail</strong>
        <span>Podaj adres użyty w formularzu zamówienia.</span>
    </div>

    <div class="simple-note">
        <strong>3. Wynik</strong>
        <span>Portal pokaże status, dane dostawy i produkty.</span>
    </div>
</section>

<section class="status-zamowienia-page">
    <div class="details-card mb-4">
        <h2 class="h5 mb-3">Wyszukaj zamówienie</h2>

        <form asp-controller="StatusZamowienia"
              asp-action="Index"
              method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-5">
                    <label asp-for="NumerZamowienia" class="form-label"></label>
                    <input asp-for="NumerZamowienia"
                           class="form-control"
                           placeholder="WWW-20260616-001" />
                    <span asp-validation-for="NumerZamowienia" class="text-danger"></span>
                </div>

                <div class="col-12 col-lg-5">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="email@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-12 col-lg-2">
                    <button type="submit" class="btn btn-primary w-100">
                        Sprawdź
                    </button>
                </div>
            </div>
        </form>
    </div>

    @if (Model.Wynik != null)
    {
        <div class="details-card mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                <div>
                    <span class="portal-badge">Zamówienie</span>

                    <h2 class="h4 mt-2 mb-1">
                        @Model.Wynik.NumerZamowienia
                    </h2>

                    @if (Model.Wynik.DataZamowienia != null)
                    {
                        <div class="text-muted">
                            Data zamówienia: @Model.Wynik.DataZamowienia.Value.ToString("dd.MM.yyyy")
                        </div>
                    }
                </div>

                <span class="availability-badge available">
                    @Model.Wynik.Status
                </span>
            </div>

            <div class="status-summary-grid">
                <div class="status-summary-item">
                    <span>Klient</span>
                    <strong>@Model.Wynik.ImieNazwisko</strong>
                </div>

                <div class="status-summary-item">
                    <span>E-mail</span>
                    <strong>@Model.Wynik.Email</strong>
                </div>

                <div class="status-summary-item">
                    <span>Telefon</span>
                    <strong>
                        @if (!string.IsNullOrWhiteSpace(Model.Wynik.Telefon))
                        {
                            @Model.Wynik.Telefon
                        }
                        else
                        {
                            <text>brak danych</text>
                        }
                    </strong>
                </div>

                <div class="status-summary-item">
                    <span>Wartość</span>
                    <strong class="price-text">@Model.Wynik.WartoscRazem.ToString("C")</strong>
                </div>
            </div>

            <div class="status-address-box mt-3">
                <span>Adres dostawy</span>
                <strong>@Model.Wynik.AdresDostawy</strong>
            </div>
        </div>

        <div class="details-card">
            <h2 class="h5 mb-3">Produkty w zamówieniu</h2>

            @if (Model.Wynik.Pozycje.Any())
            {
                <div class="client-order-items">
                    <div class="client-order-row client-order-header">
                        <div>Produkt</div>
                        <div>Ilość</div>
                        <div>Cena</div>
                        <div>Wartość</div>
                    </div>

                    @foreach (var item in Model.Wynik.Pozycje)
                    {
                        <div class="client-order-row">
                            <div class="client-order-product">
                                <strong>@item.NazwaTowaru</strong>

                                @if (!string.IsNullOrWhiteSpace(item.KodTowaru))
                                {
                                    <span>@item.KodTowaru</span>
                                }
                            </div>

                            <div>
                                <span class="client-order-label">Ilość</span>
                                @item.Ilosc
                            </div>

                            <div>
                                <span class="client-order-label">Cena</span>
                                @item.CenaJednostkowa.ToString("C")
                            </div>

                            <div>
                                <span class="client-order-label">Wartość</span>
                                <strong>@item.Wartosc.ToString("C")</strong>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state empty-state-small">
                    Brak pozycji zamówienia.
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state empty-state-small">
            Wpisz numer zamówienia i e-mail, aby zobaczyć status realizacji.
        </div>
    }
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}