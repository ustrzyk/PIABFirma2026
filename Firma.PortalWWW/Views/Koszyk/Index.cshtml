@model Firma.PortalWWW.Models.KoszykViewModel

@{
    ViewData["Title"] = "Koszyk";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";

    var pozycje = Model.Pozycje.ToList();
    var liczbaProduktow = pozycje.Count;
    var liczbaSztuk = Model.LiczbaSztuk;
    var czyKoszykMaProdukty = pozycje.Any();
}

<section class="client-portal-hero mb-4">
    <div class="row g-4 align-items-center">
        <div class="col-12">
            <span class="portal-badge">Koszyk</span>

            <h1 class="display-6 fw-bold mt-3 mb-3">
                Koszyk
            </h1>

            <p class="hero-text mb-0">
                Sprawdź produkty przed złożeniem zamówienia.
            </p>

            <div class="hero-actions">
                @if (czyKoszykMaProdukty)
                {
                    <a asp-controller="Koszyk"
                       asp-action="Zamowienie"
                       class="btn btn-primary btn-lg">
                        Złóż zamówienie
                    </a>
                }

                <a href="/Sklep/Index"
                   class="btn btn-outline-secondary btn-lg">
                    Kontynuuj zakupy
                </a>
            </div>
        </div>
    </div>
</section>

@if (TempData["KoszykKomunikat"] != null)
{
    <div class="alert alert-info">
        @TempData["KoszykKomunikat"]
    </div>
}

@if (czyKoszykMaProdukty)
{
    <section class="details-card mb-4">
        <div class="account-section-header">
            <div>
                <span class="portal-badge">Produkty</span>

                <h2 class="h5 mt-2 mb-0">
                    Produkty w koszyku
                </h2>
            </div>

            <span class="availability-badge available">
                @liczbaSztuk szt.
            </span>
        </div>

        <div class="client-order-items">
            <div class="client-order-row client-order-header">
                <div>Produkt</div>
                <div>Ilość</div>
                <div>Cena</div>
                <div>Wartość</div>
            </div>

            @foreach (var item in pozycje)
            {
                <div class="client-order-row">
                    <div class="client-order-product">
                        <strong>@item.Nazwa</strong>

                        @if (!string.IsNullOrWhiteSpace(item.Kod))
                        {
                            <span>@item.Kod</span>
                        }
                    </div>

                    <div>
                        <span class="client-order-label">Ilość</span>

                        <form asp-controller="Koszyk"
                              asp-action="ZmienIlosc"
                              method="post"
                              class="d-flex gap-2">
                            <input type="hidden" name="idTowaru" value="@item.IdTowaru" />

                            <input type="number"
                                   name="ilosc"
                                   value="@item.Ilosc"
                                   min="1"
                                   max="20"
                                   class="form-control form-control-sm" />

                            <button type="submit" class="btn btn-outline-secondary btn-sm">
                                Zmień
                            </button>
                        </form>
                    </div>

                    <div>
                        <span class="client-order-label">Cena</span>
                        @item.Cena.ToString("C")
                    </div>

                    <div>
                        <span class="client-order-label">Wartość</span>
                        <strong>@item.Wartosc.ToString("C")</strong>
                    </div>

                    <div class="client-order-product">
                        <form asp-controller="Koszyk"
                              asp-action="Usun"
                              method="post">
                            <input type="hidden" name="idTowaru" value="@item.IdTowaru" />

                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                Usuń
                            </button>
                        </form>
                    </div>
                </div>
            }

            <div class="client-order-total">
                <span>Razem</span>
                <strong>@Model.Suma.ToString("C")</strong>
            </div>
        </div>
    </section>

    <section class="details-card">
        <div class="account-section-header">
            <div>
                <span class="portal-badge">Podsumowanie</span>

                <h2 class="h5 mt-2 mb-0">
                    Wartość koszyka
                </h2>
            </div>
        </div>

        <dl class="details-list-clean mb-3">
            <dt>Produkty</dt>
            <dd>@liczbaProduktow</dd>

            <dt>Liczba sztuk</dt>
            <dd>@liczbaSztuk</dd>

            <dt>Razem</dt>
            <dd>
                <strong>@Model.Suma.ToString("C")</strong>
            </dd>
        </dl>

        <div class="checkout-actions">
            <a asp-controller="Koszyk"
               asp-action="Zamowienie"
               class="btn btn-primary">
                Złóż zamówienie
            </a>

            <a href="/Sklep/Index"
               class="btn btn-outline-secondary">
                Kontynuuj zakupy
            </a>

            <form asp-controller="Koszyk"
                  asp-action="Wyczysc"
                  method="post">
                <button type="submit" class="btn btn-outline-danger">
                    Wyczyść koszyk
                </button>
            </form>
        </div>
    </section>
}
else
{
    <section class="empty-state">
        <span class="portal-badge">Koszyk</span>

        <h2 class="h4 mt-3">
            Koszyk jest pusty
        </h2>

        <p>
            Dodaj produkty z oferty sklepu, aby złożyć zamówienie.
        </p>

        <div class="empty-state-actions">
            <a href="/Sklep/Index"
               class="btn btn-primary">
                Przejdź do sklepu
            </a>

            <a asp-controller="Promocja"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Zobacz promocje
            </a>
        </div>
    </section>
}