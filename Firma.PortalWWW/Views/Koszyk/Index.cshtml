@model Firma.PortalWWW.Models.KoszykViewModel

@{
    ViewData["Title"] = "Koszyk";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

<section class="section-heading mb-4">
    <div>
        <span class="portal-badge">Koszyk</span>
        <h1 class="h2 mt-2 mb-2">Twoje produkty</h1>
        <p class="text-muted mb-0">
            Sprawdź produkty przed złożeniem zamówienia.
        </p>
    </div>

    <div class="section-summary">
        <strong>@Model.LiczbaSztuk</strong>
        <span>sztuk</span>
    </div>
</section>

@if (TempData["KoszykKomunikat"] != null)
{
    <div class="alert alert-info">
        @TempData["KoszykKomunikat"]
    </div>
}

@if (Model.Pozycje.Any())
{
    <section class="cart-layout">
        <div class="cart-items">
            @foreach (var item in Model.Pozycje)
            {
                <article class="cart-item-card">
                    <div class="cart-item-image-wrap">
                        @if (!string.IsNullOrWhiteSpace(item.FotoUrl))
                        {
                            <img src="@item.FotoUrl"
                                 alt="@item.Nazwa"
                                 class="cart-item-image" />
                        }
                        else
                        {
                            <img src="~/content/CA.png"
                                 alt="@item.Nazwa"
                                 class="cart-item-image" />
                        }
                    </div>

                    <div class="cart-item-main">
                        <div class="product-meta mb-2">
                            <span>@item.Rodzaj</span>
                            <span>@item.Producent</span>
                        </div>

                        <h2 class="h5 mb-1">@item.Nazwa</h2>

                        <div class="text-muted small mb-2">
                            Kod: @item.Kod
                        </div>

                        <div class="cart-item-values">
                            <div>
                                <span>Cena</span>
                                <strong>@item.Cena.ToString("C")</strong>
                            </div>

                            <div>
                                <span>Ilość</span>
                                <strong>@item.Ilosc</strong>
                            </div>

                            <div>
                                <span>Wartość</span>
                                <strong class="price-text">@item.Wartosc.ToString("C")</strong>
                            </div>
                        </div>
                    </div>

                    <div class="cart-item-actions">
                        <form asp-controller="Koszyk"
                              asp-action="ZmienIlosc"
                              method="post"
                              class="cart-quantity-form">
                            <input type="hidden" name="idTowaru" value="@item.IdTowaru" />

                            <label class="form-label small text-muted mb-1">Ilość</label>

                            <div class="d-flex gap-2">
                                <input type="number"
                                       name="ilosc"
                                       value="@item.Ilosc"
                                       min="1"
                                       max="20"
                                       class="form-control" />

                                <button type="submit" class="btn btn-outline-secondary">
                                    Zmień
                                </button>
                            </div>
                        </form>

                        <form asp-controller="Koszyk"
                              asp-action="Usun"
                              method="post">
                            <input type="hidden" name="idTowaru" value="@item.IdTowaru" />

                            <button type="submit" class="btn btn-outline-danger w-100">
                                Usuń
                            </button>
                        </form>
                    </div>
                </article>
            }
        </div>

        <aside class="cart-summary">
            <div class="details-card">
                <h2 class="h5 mb-3">Podsumowanie</h2>

                <dl class="details-list-clean mb-3">
                    <dt>Liczba sztuk</dt>
                    <dd>@Model.LiczbaSztuk</dd>

                    <dt>Wartość razem</dt>
                    <dd>
                        <strong class="price-text">@Model.Suma.ToString("C")</strong>
                    </dd>
                </dl>

                <a asp-controller="Koszyk"
                   asp-action="Zamowienie"
                   class="btn btn-primary w-100 mb-2">
                    Złóż zamówienie
                </a>

                <a href="/Sklep/Index"
                   class="btn btn-outline-secondary w-100 mb-2">
                    Kontynuuj zakupy
                </a>

                <form asp-controller="Koszyk"
                      asp-action="Wyczysc"
                      method="post">
                    <button type="submit" class="btn btn-outline-danger w-100">
                        Wyczyść koszyk
                    </button>
                </form>
            </div>
        </aside>
    </section>
}
else
{
    <div class="empty-state">
        <span class="portal-badge">Koszyk</span>

        <h2 class="h4 mt-3">Koszyk jest pusty</h2>

        <p>
            Dodaj produkty z oferty sklepu, a następnie wróć tutaj, żeby złożyć zamówienie.
        </p>

        <div class="empty-state-actions">
            <a href="/Sklep/Index"
               class="btn btn-primary">
                Przejdź do sklepu
            </a>

            <a asp-controller="Promocja"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Zobacz promocje
            </a>
        </div>
    </div>
}