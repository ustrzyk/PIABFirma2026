@model Firma.Services.Data.Dto.ZamowieniaPubliczne.ZamowieniePubliczneWynikDto

@{
    ViewData["Title"] = "Zamówienie złożone";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";

    var emailZamowienia = ViewBag.EmailZamowienia as string ?? string.Empty;
    var czyZalogowanyKlient = User.Identity?.IsAuthenticated == true;
}

<section class="client-portal-hero mb-4">
    <div class="row g-4 align-items-center">
        <div class="col-12 col-lg-8">
            <span class="portal-badge">Zamówienie</span>

            <h1 class="display-6 fw-bold mt-3 mb-3">
                Zamówienie zostało złożone
            </h1>

            <p class="hero-text mb-0">
                Zapisz numer zamówienia. Będzie potrzebny do sprawdzenia statusu bez logowania.
            </p>

            <div class="hero-actions">
                @if (czyZalogowanyKlient)
                {
                    <a asp-controller="KontoKlienta"
                       asp-action="Panel"
                       class="btn btn-primary btn-lg">
                        Moje konto
                    </a>
                }
                else if (!string.IsNullOrWhiteSpace(emailZamowienia))
                {
                    <a asp-controller="KontoKlienta"
                       asp-action="RejestracjaPoZamowieniu"
                       asp-route-numerZamowienia="@Model.NumerZamowienia"
                       asp-route-email="@emailZamowienia"
                       class="btn btn-primary btn-lg">
                        Utwórz konto
                    </a>
                }

                <a asp-controller="StatusZamowienia"
                   asp-action="Index"
                   class="btn btn-outline-secondary btn-lg">
                    Sprawdź status
                </a>

                <a href="/Sklep/Index"
                   class="btn btn-outline-secondary btn-lg">
                    Wróć do sklepu
                </a>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="client-login-card">
                <strong>Potwierdzenie</strong>

                <div>
                    <span>🧾</span>
                    <p>Numer: <strong>@Model.NumerZamowienia</strong></p>
                </div>

                <div>
                    <span>📦</span>
                    <p>Status: <strong>nowe</strong></p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="checkout-steps mb-4">
    <div class="checkout-step checkout-step-done">
        <span>1</span>
        <strong>Koszyk</strong>
        <small>Produkty dodane</small>
    </div>

    <div class="checkout-step checkout-step-done">
        <span>2</span>
        <strong>Dane</strong>
        <small>Dane zapisane</small>
    </div>

    <div class="checkout-step checkout-step-current">
        <span>3</span>
        <strong>Potwierdzenie</strong>
        <small>Zamówienie przyjęte</small>
    </div>
</section>

<section class="checkout-page-layout">
    <div class="checkout-main-column">
        <div class="details-card mb-4">
            <div class="account-section-header">
                <div>
                    <span class="portal-badge">Numer zamówienia</span>

                    <h2 class="h4 mt-2 mb-0">
                        @Model.NumerZamowienia
                    </h2>
                </div>

                <span class="availability-badge available">
                    nowe
                </span>
            </div>

            <dl class="details-list-clean mb-0">
                <dt>Numer zamówienia</dt>
                <dd>
                    <strong>@Model.NumerZamowienia</strong>
                </dd>

                <dt>E-mail</dt>
                <dd>
                    @if (!string.IsNullOrWhiteSpace(emailZamowienia))
                    {
                        <strong>@emailZamowienia</strong>
                    }
                    else
                    {
                        <span class="text-muted">E-mail podany w formularzu zamówienia</span>
                    }
                </dd>

                <dt>Status początkowy</dt>
                <dd>
                    <span class="availability-badge available">nowe</span>
                </dd>
            </dl>
        </div>

        <div class="details-card">
            <div class="account-section-header">
                <div>
                    <span class="portal-badge">Co dalej?</span>

                    <h2 class="h5 mt-2 mb-0">
                        Sprawdzenie statusu
                    </h2>
                </div>
            </div>

            @if (czyZalogowanyKlient)
            {
                <div class="simple-note">
                    <strong>Status w panelu klienta</strong>
                    <span>
                        Jesteś zalogowany, więc zamówienie będzie widoczne w zakładce „Moje konto”.
                    </span>
                </div>
            }
            else
            {
                <div class="simple-note">
                    <strong>Status bez logowania</strong>
                    <span>
                        Wejdź w „Status zamówienia” i wpisz numer zamówienia oraz adres e-mail z formularza.
                    </span>
                </div>
            }
        </div>
    </div>

    <aside class="checkout-sidebar-column">
        <div class="details-card mb-4">
            <div class="account-section-header">
                <div>
                    <span class="portal-badge">Skróty</span>

                    <h2 class="h5 mt-2 mb-0">
                        Przejdź dalej
                    </h2>
                </div>
            </div>

            <div class="order-detail-actions">
                @if (czyZalogowanyKlient)
                {
                    <a asp-controller="KontoKlienta"
                       asp-action="Panel"
                       class="btn btn-primary w-100">
                        Moje konto
                    </a>
                }
                else if (!string.IsNullOrWhiteSpace(emailZamowienia))
                {
                    <a asp-controller="KontoKlienta"
                       asp-action="RejestracjaPoZamowieniu"
                       asp-route-numerZamowienia="@Model.NumerZamowienia"
                       asp-route-email="@emailZamowienia"
                       class="btn btn-primary w-100">
                        Utwórz konto z zamówienia
                    </a>
                }

                <a asp-controller="StatusZamowienia"
                   asp-action="Index"
                   class="btn btn-outline-secondary w-100">
                    Sprawdź status
                </a>

                <a href="/Sklep/Index"
                   class="btn btn-outline-secondary w-100">
                    Wróć do sklepu
                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-secondary w-100">
                    Strona główna
                </a>
            </div>
        </div>

        <div class="details-card">
            <div class="account-section-header">
                <div>
                    <span class="portal-badge">Informacja</span>

                    <h2 class="h5 mt-2 mb-0">
                        Zamówienie
                    </h2>
                </div>
            </div>

            <div class="simple-note">
                <strong>Zamówienie przyjęte</strong>
                <span>
                    Pracownik intranetu może później zmienić jego status, np. na „w trakcie”, „wysłane” albo „zakończone”.
                </span>
            </div>
        </div>
    </aside>
</section>