@model Firma.Services.Data.Dto.ZamowieniaPubliczne.ZamowieniePubliczneWynikDto

@{
    ViewData["Title"] = "Zamówienie złożone";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";

    var emailZamowienia = ViewBag.EmailZamowienia as string ?? string.Empty;
    var czyZalogowanyKlient = User.Identity?.IsAuthenticated == true;
}

<section class="portal-hero mb-4">
    <div class="row g-4 align-items-center">
        <div class="col-12 col-lg-8">
            <span class="portal-badge">✅ Zamówienie</span>

            <h1 class="display-6 fw-bold mt-3 mb-3">
                Dziękujemy za złożenie zamówienia
            </h1>

            <p class="hero-text mb-0">
                Zamówienie zostało zapisane i trafiło do obsługi. Klient może wrócić do portalu klienta i sprawdzić status.
            </p>

            <div class="hero-actions">
                @if (czyZalogowanyKlient)
                {
                    <a asp-controller="KontoKlienta"
                       asp-action="Panel"
                       class="btn btn-primary btn-lg">
                        <span class="btn-icon">👤</span>
                        Moje konto
                    </a>
                }
                else if (!string.IsNullOrWhiteSpace(emailZamowienia))
                {
                    <a asp-controller="KontoKlienta"
                       asp-action="RejestracjaPoZamowieniu"
                       asp-route-numerZamowienia="@Model.NumerZamowienia"
                       asp-route-email="@emailZamowienia"
                       class="btn btn-primary btn-lg">
                        <span class="btn-icon">👤</span>
                        Utwórz konto z zamówienia
                    </a>
                }

                <a asp-controller="StatusZamowienia"
                   asp-action="Index"
                   class="btn btn-outline-secondary btn-lg">
                    <span class="btn-icon">🧾</span>
                    Portal klienta
                </a>

                <a href="/Sklep/Index"
                   class="btn btn-outline-secondary btn-lg">
                    Wróć do sklepu
                </a>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="hero-card">
                <div class="hero-card-title">Dane zamówienia</div>

                <div class="hero-feature">
                    <strong>@Model.NumerZamowienia</strong>
                    <span>Numer zamówienia potrzebny do sprawdzenia statusu.</span>
                </div>

                <div class="hero-feature">
                    <strong>
                        @if (!string.IsNullOrWhiteSpace(emailZamowienia))
                        {
                            @emailZamowienia
                        }
                        else
                        {
                            <text>E-mail z formularza</text>
                        }
                    </strong>
                    <span>Adres e-mail użyty przy składaniu zamówienia.</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="confirmation-grid">
    <article class="details-card">
        <span class="home-quick-icon">🧾</span>

        <h2 class="h5 mb-3">Co klient widzi po zakupie?</h2>

        <div class="confirmation-steps">
            <div class="confirmation-step">
                <span>1</span>
                <div>
                    <strong>Portal klienta</strong>
                    <p>Klient wchodzi w menu „Portal klienta”.</p>
                </div>
            </div>

            <div class="confirmation-step">
                <span>2</span>
                <div>
                    <strong>Wpisuje dane zamówienia</strong>
                    <p>Numer zamówienia: <strong>@Model.NumerZamowienia</strong></p>
                </div>
            </div>

            <div class="confirmation-step">
                <span>3</span>
                <div>
                    <strong>Otrzymuje podgląd</strong>
                    <p>Widoczny jest status, etap realizacji, adres dostawy i produkty.</p>
                </div>
            </div>
        </div>
    </article>

    <aside class="details-card">
        <span class="home-quick-icon">👤</span>

        <h2 class="h5 mb-3">Konto klienta</h2>

        @if (czyZalogowanyKlient)
        {
            <p class="text-muted">
                Zamówienie zostało przypisane do Twojego konta klienta.
            </p>

            <a asp-controller="KontoKlienta"
               asp-action="Panel"
               class="btn btn-primary w-100">
                Przejdź do mojego konta
            </a>
        }
        else if (!string.IsNullOrWhiteSpace(emailZamowienia))
        {
            <p class="text-muted">
                Możesz teraz utworzyć konto klienta na podstawie tego zamówienia. Po utworzeniu konta zamówienie pojawi się w panelu „Moje konto”.
            </p>

            <a asp-controller="KontoKlienta"
               asp-action="RejestracjaPoZamowieniu"
               asp-route-numerZamowienia="@Model.NumerZamowienia"
               asp-route-email="@emailZamowienia"
               class="btn btn-primary w-100">
                Utwórz konto z zamówienia
            </a>

            <div class="simple-note mt-3">
                Konto zostanie połączone z adresem e-mail użytym w zamówieniu.
            </div>
        }
        else
        {
            <p class="text-muted">
                Portal klienta działa bez konta. Wystarczy numer zamówienia i e-mail z formularza.
            </p>

            <a asp-controller="StatusZamowienia"
               asp-action="Index"
               class="btn btn-outline-secondary w-100">
                Sprawdź status
            </a>
        }
    </aside>
</section>