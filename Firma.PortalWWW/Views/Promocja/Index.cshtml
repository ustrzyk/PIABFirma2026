@model IEnumerable<Firma.Data.Data.CMS.Promocja>

@{
    ViewData["Title"] = "Promocje";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

<div class="portal-header mb-4">
    <div>
        <span class="portal-badge">Sklep</span>
        <h1 class="h2 mt-2 mb-1">Promocje</h1>
        <p class="text-muted mb-0">Aktualne promocje widoczne w portalu.</p>
    </div>
</div>

<div class="card page-card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 sklep-table">
                <thead>
                    <tr>
                        <th>Tytuł</th>
                        <th>Rabat</th>
                        <th>Data od</th>
                        <th>Data do</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.Tytul</strong></td>
                            <td>
                                <span class="badge bg-primary">@item.RabatProcentowy %</span>
                            </td>
                            <td>@item.DataOd?.ToString("dd.MM.yyyy")</td>
                            <td>@item.DataDo?.ToString("dd.MM.yyyy")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-primary"
                                   asp-controller="Promocja"
                                   asp-action="Szczegoly"
                                   asp-route-id="@item.IdPromocji">
                                    Szczegóły
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info mt-4">
        Brak promocji do wyświetlenia.
    </div>
}
