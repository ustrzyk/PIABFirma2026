@model IEnumerable<Firma.Services.Data.Dto.Promocje.PromocjaListaItemDto>

@{
    ViewData["Title"] = "Promocje";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

<div class="portal-header mb-4">
    <div>
        <h1 class="h3 mb-1">Promocje</h1>
        <p class="text-muted mb-0">
            Aktualne promocje i informacje handlowe.
        </p>
    </div>
</div>

<div class="row g-4">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card page-card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="mb-3">
                            <span class="badge bg-danger">
                                -@item.RabatProcentowy%
                            </span>
                        </div>

                        <h2 class="h5">@item.Tytul</h2>

                        <p class="text-muted tekst-skrot">
                            @item.Opis
                        </p>

                        <div class="small text-muted mb-3">
                            @if (item.DataOd != null)
                            {
                                <div>Od: @item.DataOd.Value.ToShortDateString()</div>
                            }

                            @if (item.DataDo != null)
                            {
                                <div>Do: @item.DataDo.Value.ToShortDateString()</div>
                            }
                        </div>

                        <a class="btn btn-primary mt-auto"
                           asp-controller="Promocja"
                           asp-action="Szczegoly"
                           asp-route-id="@item.IdPromocji">
                            Szczegóły
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info">
                Brak promocji do wyświetlenia.
            </div>
        </div>
    }
</div>