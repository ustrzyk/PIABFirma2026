@model IEnumerable<Firma.Services.Data.Dto.Promocje.PromocjaListaItemDto>

@{
    ViewData["Title"] = "Promocje";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
    var promocje = Model?.ToList() ?? new List<Firma.Services.Data.Dto.Promocje.PromocjaListaItemDto>();
}

<section class="section-heading mb-4">
    <div>
        <span class="portal-badge">Promocje</span>
        <h1 class="h2 mt-2 mb-2">Aktualne oferty specjalne</h1>
        <p class="text-muted mb-0">
            Sprawdź rabaty i informacje handlowe dostępne w portalu.
        </p>
    </div>

    <div class="section-summary">
        <strong>@promocje.Count</strong>
        <span>promocji</span>
    </div>
</section>

@if (promocje.Any())
{
    <section class="product-grid">
        @foreach (var item in promocje)
        {
            <article class="product-card">
                <div class="product-card-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                        <span class="promo-badge">
                            -@item.RabatProcentowy%
                        </span>

                        <span class="availability-badge available">
                            oferta
                        </span>
                    </div>

                    <h2 class="product-title">
                        <a asp-controller="Promocja"
                           asp-action="Szczegoly"
                           asp-route-id="@item.IdPromocji">
                            @item.Tytul
                        </a>
                    </h2>

                    <p class="product-description tekst-skrot">
                        @item.Opis
                    </p>

                    <dl class="details-list-clean mb-3">
                        <dt>Od</dt>
                        <dd>
                            @if (item.DataOd != null)
                            {
                                @item.DataOd.Value.ToString("dd.MM.yyyy")
                            }
                            else
                            {
                                <span class="text-muted">bez daty</span>
                            }
                        </dd>

                        <dt>Do</dt>
                        <dd>
                            @if (item.DataDo != null)
                            {
                                @item.DataDo.Value.ToString("dd.MM.yyyy")
                            }
                            else
                            {
                                <span class="text-muted">bez daty</span>
                            }
                        </dd>
                    </dl>

                    <div class="product-card-footer">
                        <div>
                            <div class="small text-muted">Rabat</div>
                            <div class="price-text product-price">
                                @item.RabatProcentowy%
                            </div>
                        </div>

                        <a class="btn btn-primary"
                           asp-controller="Promocja"
                           asp-action="Szczegoly"
                           asp-route-id="@item.IdPromocji">
                            Szczegóły
                        </a>
                    </div>
                </div>
            </article>
        }
    </section>
}
else
{
    <div class="empty-state">
        <span class="portal-badge">Brak promocji</span>

        <h2 class="h4 mt-3">Aktualnie nie ma ofert specjalnych</h2>

        <p>
            Promocje pojawią się tutaj po ich aktywacji w systemie.
            Na razie możesz przejść do pełnej oferty sklepu.
        </p>

        <div class="empty-state-actions">
            <a asp-controller="Sklep"
               asp-action="Index"
               class="btn btn-primary">
                Przejdź do sklepu
            </a>

            <a asp-controller="Producent"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Zobacz producentów
            </a>
        </div>
    </div>
}