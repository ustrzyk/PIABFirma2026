@model Firma.Data.Data.CMS.Promocja

@{
    ViewData["Title"] = Model.Tytul;
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

<div class="portal-header mb-4">
    <div>
        <span class="portal-badge">Promocja</span>
        <h1 class="h2 mt-2 mb-1">@Model.Tytul</h1>
        <p class="text-muted mb-0">Szczegóły promocji opublikowanej w portalu.</p>
    </div>

    <div class="mt-3 mt-md-0">
        <a class="btn btn-outline-secondary" asp-controller="Promocja" asp-action="Index">
            Powrót do promocji
        </a>
    </div>
</div>

<div class="card page-card">
    <div class="card-body p-4">
        <span class="promo-badge">-@Model.RabatProcentowy %</span>

        <dl class="row details-list mt-4 mb-0">
            <dt class="col-sm-3">Data od</dt>
            <dd class="col-sm-9">@Model.DataOd?.ToString("dd.MM.yyyy")</dd>

            <dt class="col-sm-3">Data do</dt>
            <dd class="col-sm-9">@Model.DataDo?.ToString("dd.MM.yyyy")</dd>

            <dt class="col-sm-3">Opis</dt>
            <dd class="col-sm-9 tekst-strony">@Model.Opis</dd>
        </dl>
    </div>
</div>
