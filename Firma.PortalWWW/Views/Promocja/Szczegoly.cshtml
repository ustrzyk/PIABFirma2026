@model Firma.Services.Data.Dto.Promocje.PromocjaSzczegolyDto

@{
    ViewData["Title"] = Model.Tytul;
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

<section class="portal-hero mb-4">
    <div class="row g-4 align-items-center">
        <div class="col-12 col-lg-8">
            <span class="portal-badge">🏷️ Promocja</span>

            <h1 class="display-6 fw-bold mt-3 mb-3">
                @Model.Tytul
            </h1>

            <p class="hero-text tekst-strony mb-0">
                @Model.Opis
            </p>

            <div class="hero-actions">
                <a href="/Sklep/Index"
                   class="btn btn-primary btn-lg">
                    <span class="btn-icon">🛒</span>
                    Przejdź do sklepu
                </a>

                <a asp-controller="Promocja"
                   asp-action="Index"
                   class="btn btn-outline-secondary btn-lg">
                    Wróć do promocji
                </a>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="hero-card">
                <div class="hero-card-title">Szczegóły oferty</div>

                <div class="hero-feature">
                    <strong>-@Model.RabatProcentowy%</strong>
                    <span>Rabat promocyjny.</span>
                </div>

                <div class="hero-feature">
                    <strong>
                        @if (Model.CzyAktualna)
                        {
                            <text>Aktywna</text>
                        }
                        else
                        {
                            <text>Poza terminem</text>
                        }
                    </strong>
                    <span>Status według dat.</span>
                </div>

                <div class="hero-feature">
                    <strong>
                        @if (Model.DataDo != null)
                        {
                            @Model.DataDo.Value.ToString("dd.MM.yyyy")
                        }
                        else
                        {
                            <text>Bez daty końca</text>
                        }
                    </strong>
                    <span>Termin zakończenia.</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="promo-details-grid">
    <div class="details-card">
        <span class="home-quick-icon">ℹ️</span>
        <h2 class="h5 mb-3">Opis promocji</h2>

        <p class="tekst-strony text-muted mb-0">
            @Model.Opis
        </p>
    </div>

    <div class="details-card">
        <span class="home-quick-icon">📅</span>
        <h2 class="h5 mb-3">Parametry</h2>

        <dl class="details-list-clean mb-0">
            <dt>Status</dt>
            <dd>
                @if (Model.CzyAktualna)
                {
                    <span class="availability-badge available">aktywna</span>
                }
                else
                {
                    <span class="availability-badge unavailable">poza terminem</span>
                }
            </dd>

            <dt>Rabat</dt>
            <dd>
                <strong class="price-text">@Model.RabatProcentowy%</strong>
            </dd>

            <dt>Data od</dt>
            <dd>
                @if (Model.DataOd != null)
                {
                    @Model.DataOd.Value.ToString("dd.MM.yyyy")
                }
                else
                {
                    <span class="text-muted">brak danych</span>
                }
            </dd>

            <dt>Data do</dt>
            <dd>
                @if (Model.DataDo != null)
                {
                    @Model.DataDo.Value.ToString("dd.MM.yyyy")
                }
                else
                {
                    <span class="text-muted">brak danych</span>
                }
            </dd>
        </dl>

        <div class="simple-note mt-3">
            Rabat jest informacją handlową widoczną dla klienta w portalu.
        </div>
    </div>
</section>