@model Firma.Services.Data.Dto.Promocje.PromocjaSzczegolyDto

@{
    ViewData["Title"] = Model.Tytul;
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

<div class="portal-header portal-header-responsive mb-4">
    <div>
        <h1 class="h3 mb-1">@Model.Tytul</h1>
        <p class="text-muted mb-0">
            Szczegóły promocji dostępnej w portalu.
        </p>
    </div>

    <div class="portal-actions">
        <a asp-controller="Promocja"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Powrót do promocji
        </a>
    </div>
</div>

<div class="card page-card shadow-sm">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap gap-2 mb-3">
            @if (Model.CzyAktualna)
            {
                <span class="badge bg-success">
                    aktywna
                </span>
            }
            else
            {
                <span class="badge bg-secondary">
                    poza terminem
                </span>
            }

            <span class="badge bg-danger">
                -@Model.RabatProcentowy%
            </span>
        </div>

        <h2 class="h4 mb-3">@Model.Tytul</h2>

        <p class="text-muted tekst-strony">
            @Model.Opis
        </p>

        <hr />

        <dl class="row details-list mb-0">
            <dt class="col-sm-3">Rabat</dt>
            <dd class="col-sm-9">@Model.RabatProcentowy%</dd>

            <dt class="col-sm-3">Data od</dt>
            <dd class="col-sm-9">
                @if (Model.DataOd != null)
                {
                    @Model.DataOd.Value.ToShortDateString()
                }
                else
                {
                    <span class="text-muted">brak danych</span>
                }
            </dd>

            <dt class="col-sm-3">Data do</dt>
            <dd class="col-sm-9">
                @if (Model.DataDo != null)
                {
                    @Model.DataDo.Value.ToShortDateString()
                }
                else
                {
                    <span class="text-muted">brak danych</span>
                }
            </dd>
        </dl>
    </div>
</div>