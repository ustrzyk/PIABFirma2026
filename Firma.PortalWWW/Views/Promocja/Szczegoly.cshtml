@model Firma.Services.Data.Dto.Promocje.PromocjaSzczegolyDto

@{
    ViewData["Title"] = Model.Tytul;
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

<section class="client-portal-hero mb-4">
    <div class="row g-4 align-items-center">
        <div class="col-12">
            <span class="portal-badge">Promocja</span>

            <h1 class="display-6 fw-bold mt-3 mb-3">
                @Model.Tytul
            </h1>

            <p class="hero-text tekst-strony mb-0">
                @Model.Opis
            </p>

            <div class="hero-actions">
                <a href="/Sklep/Index"
                   class="btn btn-primary btn-lg">
                    Przejdź do sklepu
                </a>

                <a asp-controller="Promocja"
                   asp-action="Index"
                   class="btn btn-outline-secondary btn-lg">
                    Wróć do promocji
                </a>
            </div>
        </div>
    </div>
</section>

<section class="customer-account-grid">
    <article class="details-card">
        <div class="account-section-header">
            <div>
                <span class="portal-badge">Opis</span>

                <h2 class="h5 mt-2 mb-0">
                    Opis promocji
                </h2>
            </div>
        </div>

        <p class="tekst-strony text-muted mb-0">
            @Model.Opis
        </p>
    </article>

    <article class="details-card">
        <div class="account-section-header">
            <div>
                <span class="portal-badge">Parametry</span>

                <h2 class="h5 mt-2 mb-0">
                    Szczegóły promocji
                </h2>
            </div>
        </div>

        <dl class="details-list-clean mb-0">
            <dt>Status</dt>
            <dd>
                @if (Model.CzyAktualna)
                {
                    <span class="availability-badge available">aktywna</span>
                }
                else
                {
                    <span class="availability-badge unavailable">poza terminem</span>
                }
            </dd>

            <dt>Rabat</dt>
            <dd>
                <strong class="price-text">@Model.RabatProcentowy%</strong>
            </dd>

            <dt>Data od</dt>
            <dd>
                @if (Model.DataOd != null)
                {
                    @Model.DataOd.Value.ToString("dd.MM.yyyy")
                }
                else
                {
                    <span class="text-muted">brak danych</span>
                }
            </dd>

            <dt>Data do</dt>
            <dd>
                @if (Model.DataDo != null)
                {
                    @Model.DataDo.Value.ToString("dd.MM.yyyy")
                }
                else
                {
                    <span class="text-muted">brak danych</span>
                }
            </dd>
        </dl>
    </article>
</section>