@model Firma.Data.Data.CMS.UstawieniePortalu

@{
    ViewData["Title"] = Model.Klucz;
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

<div class="portal-header mb-4">
    <div>
        <span class="portal-badge">Informacja</span>
        <h1 class="h2 mt-2 mb-1">@Model.Klucz</h1>
        <p class="text-muted mb-0">Szczegóły informacji portalu.</p>
    </div>

    <div class="mt-3 mt-md-0">
        <a class="btn btn-outline-secondary" asp-controller="UstawieniePortalu" asp-action="Index">
            Powrót do informacji
        </a>
    </div>
</div>

<div class="card page-card">
    <div class="card-body p-4">
        <dl class="row details-list mb-0">
            <dt class="col-sm-3">Klucz</dt>
            <dd class="col-sm-9">@Model.Klucz</dd>

            <dt class="col-sm-3">Opis</dt>
            <dd class="col-sm-9">@Model.Opis</dd>

            <dt class="col-sm-3">Wartość</dt>
            <dd class="col-sm-9 tekst-strony">@Model.Wartosc</dd>
        </dl>
    </div>
</div>
