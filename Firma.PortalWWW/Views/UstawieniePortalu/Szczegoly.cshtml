@model Firma.Services.Data.Dto.UstawieniaPortalu.UstawieniePortaluSzczegolyDto

@{
    ViewData["Title"] = Model.Klucz;
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

<div class="portal-header mb-4">
    <div>
        <h1 class="h3 mb-1">@Model.Klucz</h1>
        <p class="text-muted mb-0">
            Szczegóły informacji portalu.
        </p>
    </div>

    <a asp-controller="UstawieniePortalu"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Powrót do informacji
    </a>
</div>

<div class="card page-card shadow-sm">
    <div class="card-body p-4">
        <div class="mb-3">
            <span class="portal-badge">
                @Model.Klucz
            </span>
        </div>

        <h2 class="h4 mb-3">@Model.Klucz</h2>

        <div class="tekst-strony mb-4">
            @Model.Wartosc
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Opis))
        {
            <hr />

            <dl class="row details-list mb-0">
                <dt class="col-sm-3">Opis</dt>
                <dd class="col-sm-9">@Model.Opis</dd>
            </dl>
        }
    </div>
</div>