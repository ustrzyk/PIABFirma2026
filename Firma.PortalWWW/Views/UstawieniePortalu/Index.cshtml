@model IEnumerable<Firma.Services.Data.Dto.UstawieniaPortalu.UstawieniePortaluListaItemDto>

@{
    ViewData["Title"] = "Informacje";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

<div class="portal-header mb-4">
    <div>
        <h1 class="h3 mb-1">Informacje portalu</h1>
        <p class="text-muted mb-0">
            Wybrane informacje konfigurowane z poziomu Intranetu.
        </p>
    </div>
</div>

<div class="row g-4 desktop-grid-wrap">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="col-12 col-md-6">
                <div class="card page-card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5">@item.Klucz</h2>

                        <p class="text-muted tekst-skrot">
                            @item.Wartosc
                        </p>

                        @if (!string.IsNullOrWhiteSpace(item.Opis))
                        {
                            <p class="small text-muted">
                                @item.Opis
                            </p>
                        }

                        <a class="btn btn-primary mt-auto"
                           asp-controller="UstawieniePortalu"
                           asp-action="Szczegoly"
                           asp-route-id="@item.IdUstawieniaPortalu">
                            Szczegóły
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info">
                Brak informacji portalu do wyświetlenia.
            </div>
        </div>
    }
</div>

@if (Model != null && Model.Any())
{
    <div class="mobile-card-list">
        @foreach (var item in Model)
        {
            <div class="mobile-info-card">
                <div class="mobile-info-body">
                    <div class="mb-2">
                        <span class="portal-badge">@item.Klucz</span>
                    </div>

                    <h2 class="h6 mb-2">@item.Klucz</h2>

                    <div class="small text-muted tekst-skrot mb-3">
                        @item.Wartosc
                    </div>

                    @if (!string.IsNullOrWhiteSpace(item.Opis))
                    {
                        <div class="small text-muted mb-3">
                            @item.Opis
                        </div>
                    }

                    <a class="btn btn-primary w-100"
                       asp-controller="UstawieniePortalu"
                       asp-action="Szczegoly"
                       asp-route-id="@item.IdUstawieniaPortalu">
                        Szczegóły
                    </a>
                </div>
            </div>
        }
    </div>
}