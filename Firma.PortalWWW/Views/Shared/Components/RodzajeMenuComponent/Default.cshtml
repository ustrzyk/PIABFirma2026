@model IEnumerable<Firma.Services.Data.Dto.Rodzaje.RodzajMenuItemDto>

@{
    var rodzaje = Model?.ToList() ?? new List<Firma.Services.Data.Dto.Rodzaje.RodzajMenuItemDto>();
}

<a class="category-link category-link-main"
   href="/Sklep/Index">
    Wszystkie produkty
</a>

@if (rodzaje.Any())
{
    foreach (var item in rodzaje)
    {
        <a class="category-link"
           asp-area=""
           asp-controller="Sklep"
           asp-action="Index"
           asp-route-id="@item.IdRodzaju">
            @item.Nazwa
        </a>
    }
}
else
{
    <span class="category-empty">
        Brak aktywnych kategorii
    </span>
}