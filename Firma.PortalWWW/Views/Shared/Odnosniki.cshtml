@model IEnumerable<Firma.Services.Data.Dto.CMS.StronaMenuItemDto>

<ul class="navbar-nav me-auto mb-2 mb-lg-0 portal-nav">
    <li class="nav-item">
        <a class="nav-link"
           asp-area=""
           asp-controller="Home"
           asp-action="Index">
            <span class="nav-icon">🏠</span>
            Start
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link"
           href="/Sklep/Index">
            <span class="nav-icon">🧩</span>
            Sklep
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link"
           asp-area=""
           asp-controller="Promocja"
           asp-action="Index">
            <span class="nav-icon">🏷️</span>
            Promocje
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link"
           asp-area=""
           asp-controller="Producent"
           asp-action="Index">
            <span class="nav-icon">🏭</span>
            Producenci
        </a>
    </li>

    @if (Model != null)
    {
        foreach (var item in Model)
        {
            <li class="nav-item">
                <a class="nav-link"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   asp-route-id="@item.IdStrony">
                    <span class="nav-icon">ℹ️</span>
                    @item.LinkTytul
                </a>
            </li>
        }
    }

    <li class="nav-item">
        <a class="nav-link"
           asp-area=""
           asp-controller="StanMagazynowy"
           asp-action="Index">
            <span class="nav-icon">📦</span>
            Dostępność
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link"
           asp-area=""
           asp-controller="StatusZamowienia"
           asp-action="Index">
            <span class="nav-icon">🧾</span>
            Status
        </a>
    </li>
</ul>