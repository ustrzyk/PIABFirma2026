@model IEnumerable<Firma.Services.Data.Dto.CMS.StronaMenuItemDto>

@functions {
    private static string Normalizuj(string? tekst)
    {
        return (tekst ?? string.Empty)
            .Trim()
            .ToLowerInvariant();
    }

    private static bool CzyUkrycStroneZCms(string? tytul)
    {
        var tekst = Normalizuj(tytul);

        return tekst == "start"
            || tekst == "sklep"
            || tekst == "promocje"
            || tekst == "producenci"
            || tekst == "dostępność"
            || tekst == "dostepnosc"
            || tekst == "status"
            || tekst == "status zamówienia"
            || tekst == "status zamowienia"
            || tekst == "portal klienta"
            || tekst == "koszyk"
            || tekst == "moje konto"
            || tekst == "konto klienta"
            || tekst == "logowanie"
            || tekst == "rejestracja"
            || tekst == "produkty"
            || tekst == "prywatność"
            || tekst == "prywatnosc";
    }
}

@{
    var stronyInformacyjne = Model?
        .Where(s => !CzyUkrycStroneZCms(s.LinkTytul))
        .OrderBy(s => s.LinkTytul)
        .ToList()
        ?? new List<Firma.Services.Data.Dto.CMS.StronaMenuItemDto>();
}

<ul class="navbar-nav me-auto mb-2 mb-lg-0 portal-nav">
    <li class="nav-item">
        <a class="nav-link"
           asp-area=""
           asp-controller="Home"
           asp-action="Index">
            Start
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link"
           href="/Sklep/Index">
            Sklep
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link"
           asp-area=""
           asp-controller="Promocja"
           asp-action="Index">
            Promocje
        </a>
    </li>

    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle"
           href="#"
           id="menuInformacje"
           role="button"
           data-bs-toggle="dropdown"
           aria-expanded="false">
            Informacje
        </a>

        <ul class="dropdown-menu portal-info-dropdown" aria-labelledby="menuInformacje">
            <li>
                <a class="dropdown-item"
                   asp-area=""
                   asp-controller="Producent"
                   asp-action="Index">
                    Producenci
                </a>
            </li>

            <li>
                <a class="dropdown-item"
                   asp-area=""
                   asp-controller="StanMagazynowy"
                   asp-action="Index">
                    Dostępność
                </a>
            </li>

            @if (stronyInformacyjne.Any())
            {
                <li>
                    <hr class="dropdown-divider" />
                </li>

                foreach (var item in stronyInformacyjne)
                {
                    <li>
                        <a class="dropdown-item"
                           asp-area=""
                           asp-controller="Home"
                           asp-action="Index"
                           asp-route-id="@item.IdStrony">
                            @item.LinkTytul
                        </a>
                    </li>
                }
            }
        </ul>
    </li>

    <li class="nav-item">
        <a class="nav-link"
           asp-area=""
           asp-controller="StatusZamowienia"
           asp-action="Index">
            Status zamówienia
        </a>
    </li>
</ul>