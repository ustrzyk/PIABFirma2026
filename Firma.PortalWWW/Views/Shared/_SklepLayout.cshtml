@using System.Text.Json
@using Firma.PortalWWW.Models
@using Firma.Services.Data.Dto.CMS
@using Microsoft.AspNetCore.Http

@{
    var wyglad = ViewBag.WygladPortalu as PortalWygladDto ?? new PortalWygladDto();
    var strony = ViewBag.ModelStrony as IEnumerable<StronaMenuItemDto> ?? Enumerable.Empty<StronaMenuItemDto>();
    var aktualnosci = ViewBag.ModelAktualnosci as IEnumerable<AktualnoscListaItemDto> ?? Enumerable.Empty<AktualnoscListaItemDto>();
    var ukryjAktualnosci = ViewBag.UkryjAktualnosci == true;

    var koszykLiczbaSztuk = 0;
    var koszykJson = Context.Session.GetString("PortalKoszyk");

    if (!string.IsNullOrWhiteSpace(koszykJson))
    {
        try
        {
            var koszyk = JsonSerializer.Deserialize<KoszykViewModel>(koszykJson);
            koszykLiczbaSztuk = koszyk?.LiczbaSztuk ?? 0;
        }
        catch
        {
            koszykLiczbaSztuk = 0;
        }
    }
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - @wyglad.NazwaPortalu</title>

    <script type="importmap"></script>

    <style>
        :root {
        --portal-bg: @wyglad.KolorTlaPortalu;
        --portal-navbar-bg: @wyglad.KolorNawigacji;
        --portal-footer-bg: @wyglad.KolorStopki;
        --portal-button-color: @wyglad.KolorPrzyciskow;
        --portal-focus-color: @wyglad.KolorAkcentu;
        }
    </style>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/portal-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/portal-client.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Firma.PortalWWW.styles.css" asp-append-version="true" />
</head>

<body>
    <header class="portal-site-header">
        <div class="portal-topbar">
            <div class="container d-flex flex-wrap align-items-center justify-content-between gap-2">
                <span>Drukarki 3D, filamenty, części i akcesoria</span>

                <span class="portal-topbar-contact">
                    @if (!string.IsNullOrWhiteSpace(wyglad.StopkaTelefon))
                    {
                        <span>☎ @wyglad.StopkaTelefon</span>
                    }

                    @if (!string.IsNullOrWhiteSpace(wyglad.StopkaEmail))
                    {
                        <a href="mailto:@wyglad.StopkaEmail">✉ @wyglad.StopkaEmail</a>
                    }
                </span>
            </div>
        </div>

        <nav class="navbar navbar-expand-xl portal-navbar">
            <div class="container">
                <a class="navbar-brand portal-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">3D</span>
                    <span>@wyglad.NazwaPortalu</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuGlowne"
                        aria-controls="menuGlowne"
                        aria-expanded="false"
                        aria-label="Przełącz menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menuGlowne">
                    @await Html.PartialAsync("Odnosniki", strony)

                    <div class="portal-navbar-actions">
                        <div class="dropdown portal-account-menu">
                            <button class="btn btn-outline-secondary dropdown-toggle"
                                    type="button"
                                    id="kontoKlientaMenu"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <span class="btn-icon">👤</span>
                                Konto
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end portal-account-dropdown" aria-labelledby="kontoKlientaMenu">
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="KontoKlienta"
                                           asp-action="Panel">
                                            <span class="nav-icon">👤</span>
                                            Moje konto
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="KontoKlienta"
                                           asp-action="Dane">
                                            <span class="nav-icon">📍</span>
                                            Dane i adres
                                        </a>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <form asp-controller="KontoKlienta"
                                              asp-action="Wyloguj"
                                              method="post">
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="dropdown-item text-danger">
                                                <span class="nav-icon">🚪</span>
                                                Wyloguj
                                            </button>
                                        </form>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="KontoKlienta"
                                           asp-action="Logowanie">
                                            <span class="nav-icon">🔐</span>
                                            Zaloguj
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="KontoKlienta"
                                           asp-action="Rejestracja">
                                            <span class="nav-icon">➕</span>
                                            Rejestracja
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>

                        <a asp-controller="Koszyk"
                           asp-action="Index"
                           class="btn btn-primary">
                            <span class="btn-icon">🛒</span>
                            Koszyk
                            @if (koszykLiczbaSztuk > 0)
                            {
                                <span class="badge bg-light text-primary ms-1">@koszykLiczbaSztuk</span>
                            }
                        </a>
                    </div>
                </div>
            </div>
        </nav>

        <div class="category-bar">
            <div class="container">
                <div class="category-header">
                    <div>
                        <span class="category-label">Kategorie produktów</span>
                        <span class="category-hint">Wybierz rodzaj asortymentu</span>
                    </div>

                    <a href="/Sklep/Index"
                       class="category-all-link">
                        Pełna oferta
                    </a>
                </div>

                <div class="category-scroller">
                    @await Component.InvokeAsync("RodzajeMenuComponent")
                </div>
            </div>
        </div>
    </header>

    <div class="page-bg">
        <main class="container portal-main">
            @RenderBody()
        </main>
    </div>

    @if (!ukryjAktualnosci)
    {
        <section class="portal-news-section">
            <div class="container">
                @await Html.PartialAsync("Aktualnosci", aktualnosci)
            </div>
        </section>
    }

    <footer class="portal-footer">
        <div class="container">
            <div class="row g-4 align-items-start">
                <div class="col-12 col-lg-5">
                    <div class="footer-brand mb-2">@wyglad.NazwaPortalu</div>
                    <div>@wyglad.StopkaTekst</div>

                    @if (!string.IsNullOrWhiteSpace(wyglad.StopkaAdres))
                    {
                        <div class="small mt-2">📍 @wyglad.StopkaAdres</div>
                    }
                </div>

                <div class="col-12 col-lg-4">
                    <div class="footer-title">Kontakt</div>

                    @if (!string.IsNullOrWhiteSpace(wyglad.StopkaEmail))
                    {
                        <a href="mailto:@wyglad.StopkaEmail">✉ @wyglad.StopkaEmail</a>
                    }

                    @if (!string.IsNullOrWhiteSpace(wyglad.StopkaTelefon))
                    {
                        <span>☎ @wyglad.StopkaTelefon</span>
                    }

                    @if (!string.IsNullOrWhiteSpace(wyglad.StopkaFacebook))
                    {
                        <a href="@wyglad.StopkaFacebook" target="_blank">Facebook</a>
                    }
                </div>

                <div class="col-12 col-lg-3">
                    <div class="footer-title">Portal</div>

                    <a href="/Sklep/Index">Sklep</a>
                    <a asp-area="" asp-controller="Promocja" asp-action="Index">Promocje</a>
                    <a asp-area="" asp-controller="Producent" asp-action="Index">Producenci</a>
                    <a asp-area="" asp-controller="StanMagazynowy" asp-action="Index">Dostępność</a>
                    <a asp-area="" asp-controller="Koszyk" asp-action="Index">Koszyk</a>
                    <a asp-area="" asp-controller="StatusZamowienia" asp-action="Index">Status zamówienia</a>
                    <a asp-area="" asp-controller="KontoKlienta" asp-action="Panel">Moje konto</a>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Prywatność</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>