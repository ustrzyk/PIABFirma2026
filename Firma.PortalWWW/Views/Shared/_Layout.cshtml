@using Firma.Services.Data.Dto.CMS

@{
    var wyglad = ViewBag.WygladPortalu as PortalWygladDto ?? new PortalWygladDto();
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - @wyglad.NazwaPortalu</title>

    <script type="importmap"></script>

    <style>
        :root {
        --portal-bg: @wyglad.KolorTlaPortalu;
        --portal-navbar-bg: @wyglad.KolorNawigacji;
        --portal-footer-bg: @wyglad.KolorStopki;
        --portal-button-color: @wyglad.KolorPrzyciskow;
        --portal-focus-color: @wyglad.KolorAkcentu;
        }
    </style>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Firma.PortalWWW.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light border-bottom shadow-sm portal-navbar">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    @wyglad.NazwaPortalu
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuGlowne"
                        aria-controls="menuGlowne"
                        aria-expanded="false"
                        aria-label="Przełącz menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menuGlowne">
                    @await Html.PartialAsync(
                        "Odnosniki",
                        (IEnumerable<Firma.Services.Data.Dto.CMS.StronaMenuItemDto>)ViewBag.ModelStrony)
                </div>
            </div>
        </nav>
    </header>

    <div class="page-bg">
        <main class="container py-4">
            @RenderBody()
        </main>
    </div>

    <section class="bg-white border-top">
        @await Html.PartialAsync(
            "Aktualnosci",
            (IEnumerable<Firma.Services.Data.Dto.CMS.AktualnoscListaItemDto>)ViewBag.ModelAktualnosci)
    </section>

    <footer class="border-top footer text-muted portal-footer">
        <div class="container py-3">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-md-6">
                    <strong>@wyglad.StopkaTekst</strong>

                    @if (!string.IsNullOrWhiteSpace(wyglad.StopkaAdres))
                    {
                        <div class="small">@wyglad.StopkaAdres</div>
                    }
                </div>

                <div class="col-12 col-md-6 text-md-end">
                    @if (!string.IsNullOrWhiteSpace(wyglad.StopkaEmail))
                    {
                        <a href="mailto:@wyglad.StopkaEmail" class="me-2">
                            @wyglad.StopkaEmail
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(wyglad.StopkaTelefon))
                    {
                        <span class="me-2">@wyglad.StopkaTelefon</span>
                    }

                    @if (!string.IsNullOrWhiteSpace(wyglad.StopkaFacebook))
                    {
                        <a href="@wyglad.StopkaFacebook" target="_blank">
                            Facebook
                        </a>
                    }

                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="ms-2">
                        Prywatność
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>