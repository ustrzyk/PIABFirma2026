@using Firma.Services.Data.Dto.ZamowieniaPubliczne
@model IEnumerable<ZamowienieKlientaListaItemDto>

@{
    ViewData["Title"] = "Moje konto";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";

    var zamowienia = Model?.ToList() ?? new List<ZamowienieKlientaListaItemDto>();
    var daneKlienta = ViewBag.DaneKlienta as KontoKlientaDaneDto;

    var liczbaZamowien = zamowienia.Count;
    var liczbaAktywnychZamowien = zamowienia.Count(z =>
        z.Status != "zakończone" &&
        z.Status != "zakonczone" &&
        z.Status != "anulowane");

    var czyMaAdres = daneKlienta != null
        && !string.IsNullOrWhiteSpace(daneKlienta.Ulica)
        && !string.IsNullOrWhiteSpace(daneKlienta.NumerDomu)
        && !string.IsNullOrWhiteSpace(daneKlienta.KodPocztowy)
        && !string.IsNullOrWhiteSpace(daneKlienta.Miasto);
}

@functions {
    private static bool CzyStatusAnulowany(string? status)
    {
        return (status ?? string.Empty).Trim().ToLowerInvariant() == "anulowane";
    }
}

<section class="client-portal-hero mb-4">
    <div class="row g-4 align-items-center">
        <div class="col-12 col-lg-8">
            <span class="portal-badge">Moje konto</span>

            <h1 class="display-6 fw-bold mt-3 mb-3">
                Panel klienta
            </h1>

            <p class="hero-text mb-0">
                W tym miejscu widzisz swoje dane, adres dostawy oraz statusy swoich zamówień.
            </p>

            <div class="hero-actions">
                <a asp-controller="KontoKlienta"
                   asp-action="Dane"
                   class="btn btn-primary btn-lg">
                    Edytuj dane i adres
                </a>

                <a href="/Sklep/Index"
                   class="btn btn-outline-secondary btn-lg">
                    Przejdź do sklepu
                </a>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="client-login-card">
                <strong>@User.Identity?.Name</strong>

                <div>
                    <span>🧾</span>
                    <p>Zamówienia: <strong>@liczbaZamowien</strong></p>
                </div>

                <div>
                    <span>📦</span>
                    <p>W realizacji: <strong>@liczbaAktywnychZamowien</strong></p>
                </div>

                <div>
                    <span>📍</span>
                    <p>
                        @if (czyMaAdres && daneKlienta != null)
                        {
                            <span>@daneKlienta.Ulica @daneKlienta.NumerDomu, @daneKlienta.Miasto</span>
                        }
                        else
                        {
                            <span>Uzupełnij adres dostawy.</span>
                        }
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@if (TempData["KomunikatKontaKlienta"] != null)
{
    <div class="alert alert-success">
        @TempData["KomunikatKontaKlienta"]
    </div>
}

<section class="account-tabs mb-4">
    <a asp-controller="KontoKlienta"
       asp-action="Panel"
       class="account-tab-card account-tab-card-active">
        <span>Konto</span>
        <strong>Panel klienta</strong>
    </a>

    <a asp-controller="KontoKlienta"
       asp-action="Dane"
       class="account-tab-card">
        <span>Dane</span>
        <strong>Kontakt i adres</strong>
    </a>

    <a href="#moje-zamowienia"
       class="account-tab-card">
        <span>Zamówienia</span>
        <strong>Statusy zamówień</strong>
    </a>

    <a href="/Sklep/Index"
       class="account-tab-card">
        <span>Sklep</span>
        <strong>Nowe zakupy</strong>
    </a>
</section>

<section class="customer-account-grid mb-4">
    <article class="details-card">
        <div class="account-section-header">
            <div>
                <span class="portal-badge">Dane</span>
                <h2 class="h5 mt-2 mb-0">Dane kontaktowe</h2>
            </div>

            <a asp-controller="KontoKlienta"
               asp-action="Dane"
               class="btn btn-sm btn-outline-primary">
                Edytuj
            </a>
        </div>

        @if (daneKlienta != null)
        {
            <dl class="details-list-clean mb-0">
                <dt>Imię i nazwisko</dt>
                <dd>@daneKlienta.Imie @daneKlienta.Nazwisko</dd>

                <dt>E-mail</dt>
                <dd>@daneKlienta.Email</dd>

                <dt>Telefon</dt>
                <dd>
                    @if (!string.IsNullOrWhiteSpace(daneKlienta.Telefon))
                    {
                        @daneKlienta.Telefon
                    }
                    else
                    {
                        <span class="text-muted">brak</span>
                    }
                </dd>
            </dl>
        }
        else
        {
            <div class="empty-state empty-state-small">
                Brak danych klienta.
            </div>
        }
    </article>

    <article class="details-card">
        <div class="account-section-header">
            <div>
                <span class="portal-badge">Adres</span>
                <h2 class="h5 mt-2 mb-0">Adres dostawy</h2>
            </div>

            <a asp-controller="KontoKlienta"
               asp-action="Dane"
               class="btn btn-sm btn-outline-primary">
                Edytuj
            </a>
        </div>

        @if (czyMaAdres && daneKlienta != null)
        {
            <dl class="details-list-clean mb-0">
                <dt>Ulica</dt>
                <dd>@daneKlienta.Ulica @daneKlienta.NumerDomu</dd>

                <dt>Numer lokalu</dt>
                <dd>
                    @if (!string.IsNullOrWhiteSpace(daneKlienta.NumerLokalu))
                    {
                        @daneKlienta.NumerLokalu
                    }
                    else
                    {
                        <span class="text-muted">brak</span>
                    }
                </dd>

                <dt>Kod i miasto</dt>
                <dd>@daneKlienta.KodPocztowy @daneKlienta.Miasto</dd>
            </dl>
        }
        else
        {
            <div class="simple-note">
                <strong>Adres nie jest zapisany</strong>
                <span>Uzupełnij adres, aby formularz zamówienia mógł wypełniać się automatycznie.</span>
            </div>
        }
    </article>
</section>

<section id="moje-zamowienia" class="customer-orders-section">
    <div class="customer-orders-heading">
        <div>
            <span class="portal-badge">Moje zamówienia</span>

            <h2 class="h4 mt-2 mb-1">
                Statusy zamówień
            </h2>

            <p class="text-muted mb-0">
                Status zamówienia jest widoczny bezpośrednio na karcie zamówienia.
            </p>
        </div>

        <a asp-controller="StatusZamowienia"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Status bez logowania
        </a>
    </div>

    @if (zamowienia.Any())
    {
        <div class="customer-orders-grid">
            @foreach (var item in zamowienia)
            {
                <article class="customer-order-card">
                    <div class="customer-order-card-header">
                        <div>
                            <span class="portal-badge">Zamówienie</span>

                            <h3 class="h5 mt-2 mb-1">
                                @item.NumerZamowienia
                            </h3>

                            @if (item.DataZamowienia != null)
                            {
                                <div class="text-muted small">
                                    @item.DataZamowienia.Value.ToString("dd.MM.yyyy")
                                </div>
                            }
                        </div>

                        @if (CzyStatusAnulowany(item.Status))
                        {
                            <span class="availability-badge unavailable">@item.Status</span>
                        }
                        else
                        {
                            <span class="availability-badge available">@item.Status</span>
                        }
                    </div>

                    <div class="customer-order-card-body">
                        <div>
                            <span>Pozycje</span>
                            <strong>@item.LiczbaPozycji</strong>
                        </div>

                        <div>
                            <span>Wartość</span>
                            <strong>@item.WartoscRazem.ToString("C")</strong>
                        </div>
                    </div>

                    <a asp-controller="KontoKlienta"
                       asp-action="Zamowienie"
                       asp-route-id="@item.IdZamowienia"
                       class="btn btn-primary w-100">
                        Szczegóły i status
                    </a>
                </article>
            }
        </div>
    }
    else
    {
        <section class="empty-state">
            <span class="portal-badge">Moje zamówienia</span>

            <h3 class="h4 mt-3">
                Nie masz jeszcze zamówień
            </h3>

            <p>
                Zamówienia pojawią się tutaj, gdy złożysz zamówienie jako zalogowany klient
                albo użyjesz tego samego adresu e-mail.
            </p>

            <div class="empty-state-actions">
                <a href="/Sklep/Index" class="btn btn-primary">
                    Przejdź do sklepu
                </a>

                <a asp-controller="StatusZamowienia"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Status bez logowania
                </a>
            </div>
        </section>
    }
</section>