@model Firma.PortalWWW.Models.KontoKlientaLogowanieViewModel

@{
    ViewData["Title"] = "Logowanie klienta";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

<section class="client-portal-hero mb-4">
    <div class="row g-4 align-items-center">
        <div class="col-12">
            <span class="portal-badge">Moje konto</span>

            <h1 class="display-6 fw-bold mt-3 mb-3">
                Logowanie klienta
            </h1>

            <p class="hero-text mb-0">
                Zaloguj się, aby sprawdzić swoje zamówienia i dane konta.
            </p>
        </div>
    </div>
</section>

<section class="account-tabs mb-4">
    <a asp-controller="KontoKlienta"
       asp-action="Logowanie"
       class="account-tab-card account-tab-card-active">
        <span>Konto</span>
        <strong>Logowanie</strong>
    </a>

    <a asp-controller="KontoKlienta"
       asp-action="Rejestracja"
       class="account-tab-card">
        <span>Nowy klient</span>
        <strong>Rejestracja</strong>
    </a>

    <a asp-controller="StatusZamowienia"
       asp-action="Index"
       class="account-tab-card">
        <span>Zamówienie</span>
        <strong>Status bez logowania</strong>
    </a>

    <a href="/Sklep/Index"
       class="account-tab-card">
        <span>Sklep</span>
        <strong>Zakupy</strong>
    </a>
</section>

<section class="details-card">
    <div class="account-section-header">
        <div>
            <span class="portal-badge">Logowanie</span>
            <h2 class="h5 mt-2 mb-0">Dane logowania</h2>
        </div>
    </div>

    <form id="formularz-logowania"
          asp-controller="KontoKlienta"
          asp-action="Logowanie"
          method="post">
        <input asp-for="ReturnUrl" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="profile-form-grid">
            <div class="profile-form-wide">
                <label asp-for="Email" class="form-label">Login</label>
                <input asp-for="Email"
                       class="form-control"
                       placeholder="Adres e-mail" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="profile-form-wide">
                <label asp-for="Haslo" class="form-label">Hasło</label>
                <input asp-for="Haslo"
                       class="form-control"
                       placeholder="Hasło" />
                <span asp-validation-for="Haslo" class="text-danger"></span>
            </div>
        </div>

        <div class="form-check mt-3">
            <input asp-for="ZapamietajMnie" class="form-check-input" />
            <label asp-for="ZapamietajMnie" class="form-check-label"></label>
        </div>

        <div class="checkout-actions">
            <button type="submit" class="btn btn-primary">
                Zaloguj
            </button>

            <a asp-controller="KontoKlienta"
               asp-action="Rejestracja"
               class="btn btn-outline-secondary">
                Utwórz konto
            </a>

            <a asp-controller="StatusZamowienia"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Status bez logowania
            </a>
        </div>
    </form>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}