@model Firma.PortalWWW.Models.KontoKlientaLogowanieViewModel

@{
    ViewData["Title"] = "Logowanie klienta";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

<section class="client-portal-hero mb-4">
    <div class="row g-4 align-items-center">
        <div class="col-12 col-lg-7">
            <span class="portal-badge">👤 Konto klienta</span>

            <h1 class="display-6 fw-bold mt-3 mb-3">
                Zaloguj się do swojego panelu
            </h1>

            <p class="hero-text mb-0">
                Po zalogowaniu zobaczysz swoje zamówienia, status realizacji, produkty i dane dostawy.
            </p>
        </div>

        <div class="col-12 col-lg-5">
            <div class="details-card">
                <h2 class="h5 mb-3">Logowanie</h2>

                <form asp-controller="KontoKlienta"
                      asp-action="Logowanie"
                      method="post">
                    <input asp-for="ReturnUrl" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email"
                               class="form-control"
                               placeholder="email@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Haslo" class="form-label"></label>
                        <input asp-for="Haslo" class="form-control" />
                        <span asp-validation-for="Haslo" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="ZapamietajMnie" class="form-check-input" />
                        <label asp-for="ZapamietajMnie" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        Zaloguj
                    </button>
                </form>

                <div class="simple-note mt-3">
                    Nie masz konta?
                    <a asp-controller="KontoKlienta"
                       asp-action="Rejestracja">
                        Zarejestruj się
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="status-instruction-grid">
    <div class="simple-note">
        <strong>1. Konto klienta</strong>
        <span>Jedno miejsce z historią Twoich zamówień.</span>
    </div>

    <div class="simple-note">
        <strong>2. Statusy</strong>
        <span>Widzisz aktualny etap realizacji zamówienia.</span>
    </div>

    <div class="simple-note">
        <strong>3. Bez szukania numeru</strong>
        <span>Po zalogowaniu nie musisz wpisywać numeru zamówienia.</span>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}