@model Firma.PortalWWW.Models.KontoKlientaPoZamowieniuViewModel

@{
    ViewData["Title"] = "Utwórz konto z zamówienia";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

<section class="client-portal-hero mb-4">
    <div class="row g-4 align-items-center">
        <div class="col-12">
            <span class="portal-badge">Moje konto</span>

            <h1 class="display-6 fw-bold mt-3 mb-3">
                Utwórz konto z zamówienia
            </h1>

            <p class="hero-text mb-0">
                Konto zostanie połączone z zamówieniem i adresem e-mail użytym przy zakupie.
            </p>
        </div>
    </div>
</section>

<section class="account-tabs mb-4">
    <a asp-controller="KontoKlienta"
       asp-action="Logowanie"
       class="account-tab-card">
        <span>Konto</span>
        <strong>Logowanie</strong>
    </a>

    <a asp-controller="KontoKlienta"
       asp-action="Rejestracja"
       class="account-tab-card">
        <span>Nowy klient</span>
        <strong>Rejestracja</strong>
    </a>

    <a asp-controller="KontoKlienta"
       asp-action="RejestracjaPoZamowieniu"
       asp-route-numerZamowienia="@Model.NumerZamowienia"
       asp-route-email="@Model.Email"
       class="account-tab-card account-tab-card-active">
        <span>Zamówienie</span>
        <strong>Konto z zamówienia</strong>
    </a>

    <a asp-controller="StatusZamowienia"
       asp-action="Index"
       class="account-tab-card">
        <span>Status</span>
        <strong>Bez logowania</strong>
    </a>
</section>

<section class="details-card">
    <div class="account-section-header">
        <div>
            <span class="portal-badge">Rejestracja</span>
            <h2 class="h5 mt-2 mb-0">Dane konta</h2>
        </div>
    </div>

    <form id="formularz-rejestracji-z-zamowienia"
          asp-controller="KontoKlienta"
          asp-action="RejestracjaPoZamowieniu"
          method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <input asp-for="NumerZamowienia" type="hidden" />

        <div class="simple-note mb-4">
            <strong>Zamówienie</strong>
            <span>@Model.NumerZamowienia</span>
        </div>

        <div class="checkout-section-box">
            <div class="checkout-section-title">Dane klienta</div>

            <div class="profile-form-grid">
                <div>
                    <label asp-for="Imie" class="form-label"></label>
                    <input asp-for="Imie" class="form-control" />
                    <span asp-validation-for="Imie" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="Nazwisko" class="form-label"></label>
                    <input asp-for="Nazwisko" class="form-control" />
                    <span asp-validation-for="Nazwisko" class="text-danger"></span>
                </div>

                <div class="profile-form-wide">
                    <label asp-for="Email" class="form-label">Login</label>
                    <input asp-for="Email"
                           class="form-control readonly-control"
                           readonly />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="profile-form-wide">
                    <label asp-for="Telefon" class="form-label"></label>
                    <input asp-for="Telefon"
                           class="form-control"
                           placeholder="Telefon" />
                    <span asp-validation-for="Telefon" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="checkout-section-box mt-4">
            <div class="checkout-section-title">Hasło</div>

            <div class="simple-note mb-3">
                <strong>Wymagania hasła</strong>
                <span>Minimum 8 znaków, mała i duża litera, cyfra oraz znak specjalny.</span>
            </div>

            <div class="profile-form-grid">
                <div>
                    <label asp-for="Haslo" class="form-label">Hasło</label>
                    <input asp-for="Haslo" class="form-control" />
                    <span asp-validation-for="Haslo" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="PowtorzHaslo" class="form-label">Powtórz hasło</label>
                    <input asp-for="PowtorzHaslo" class="form-control" />
                    <span asp-validation-for="PowtorzHaslo" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="checkout-actions">
            <button type="submit" class="btn btn-primary">
                Utwórz konto
            </button>

            <a asp-controller="KontoKlienta"
               asp-action="Logowanie"
               class="btn btn-outline-secondary">
                Mam już konto
            </a>

            <a asp-controller="StatusZamowienia"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Status zamówienia
            </a>
        </div>
    </form>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}