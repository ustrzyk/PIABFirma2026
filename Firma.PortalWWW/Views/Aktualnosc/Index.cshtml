@model Firma.Services.Data.Dto.CMS.AktualnoscSzczegolyDto

@{
    ViewData["Title"] = Model.LinkTytul;
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

<section class="client-portal-hero mb-4">
    <div class="row g-4 align-items-center">
        <div class="col-12">
            <span class="portal-badge">Aktualność</span>

            <h1 class="display-6 fw-bold mt-3 mb-3">
                @Model.Tytul
            </h1>

            <p class="hero-text mb-0">
                Informacja widoczna dla klientów sklepu.
            </p>

            <div class="hero-actions">
                <a href="/Sklep/Index"
                   class="btn btn-primary btn-lg">
                    Przejdź do sklepu
                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-secondary btn-lg">
                    Strona główna
                </a>
            </div>
        </div>
    </div>
</section>

<section class="details-card mb-4">
    <div class="account-section-header">
        <div>
            <span class="portal-badge">Treść</span>

            <h2 class="h5 mt-2 mb-0">
                Treść aktualności
            </h2>
        </div>
    </div>

    <div class="tekst-strony text-muted news-content">
        @Model.Tresc
    </div>
</section>

<section class="details-card">
    <div class="account-section-header">
        <div>
            <span class="portal-badge">Skróty</span>

            <h2 class="h5 mt-2 mb-0">
                Przejdź dalej
            </h2>
        </div>
    </div>

    <div class="checkout-actions">
        <a href="/Sklep/Index"
           class="btn btn-primary">
            Produkty
        </a>

        <a asp-controller="Promocja"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Promocje
        </a>

        <a asp-controller="Producent"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Producenci
        </a>

        <a asp-controller="StatusZamowienia"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Status zamówienia
        </a>
    </div>
</section>