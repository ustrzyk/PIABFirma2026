@model Firma.Services.Data.Dto.CMS.AktualnoscSzczegolyDto

@{
    ViewData["Title"] = Model.LinkTytul;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="portal-header mb-4">
    <div>
        <span class="portal-badge">Aktualność</span>
        <h1 class="h3 mt-2 mb-1">@Model.Tytul</h1>
        <p class="text-muted mb-0">
            Szczegóły informacji opublikowanej w portalu.
        </p>
    </div>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Powrót na stronę główną
    </a>
</div>

<div class="card page-card shadow-sm">
    <div class="card-body p-4">
        <div class="tekst-strony">
            @Model.Tresc
        </div>
    </div>
</div>