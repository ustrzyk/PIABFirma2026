@model Firma.Data.Data.Sklep.Producent

@{
    ViewData["Title"] = Model.Nazwa;
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

<div class="portal-header mb-4">
    <div>
        <span class="portal-badge">Producent</span>
        <h1 class="h2 mt-2 mb-1">@Model.Nazwa</h1>
        <p class="text-muted mb-0">Szczegóły producenta i jego produktów.</p>
    </div>

    <div class="mt-3 mt-md-0">
        <a class="btn btn-outline-secondary" asp-controller="Producent" asp-action="Index">
            Powrót do producentów
        </a>
    </div>
</div>

<div class="card page-card mb-4">
    <div class="card-body p-4">
        <dl class="row details-list mb-0">
            <dt class="col-sm-3">Nazwa</dt>
            <dd class="col-sm-9">@Model.Nazwa</dd>

            <dt class="col-sm-3">Kraj</dt>
            <dd class="col-sm-9">@Model.Kraj</dd>

            <dt class="col-sm-3">Strona WWW</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrWhiteSpace(Model.StronaWWW))
                {
                    <a href="@Model.StronaWWW" target="_blank" rel="noopener">
                        @Model.StronaWWW
                    </a>
                }
                else
                {
                    <span class="text-muted">brak</span>
                }
            </dd>

            <dt class="col-sm-3">Opis</dt>
            <dd class="col-sm-9 tekst-strony">@Model.Opis</dd>
        </dl>
    </div>
</div>

<div class="card page-card">
    <div class="card-header bg-white">
        <h2 class="h5 mb-0">Towary producenta</h2>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 sklep-table">
                <thead>
                    <tr>
                        <th>Nazwa</th>
                        <th>Cena</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Towar)
                    {
                        <tr>
                            <td><strong>@item.Nazwa</strong></td>
                            <td>@item.Cena.ToString("C")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-controller="Sklep"
                                   asp-action="Szczegoly"
                                   asp-route-id="@item.IdTowaru">
                                    Zobacz towar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
