@model Firma.Services.Data.Dto.Producenci.ProducentSzczegolyDto

@{
    ViewData["Title"] = Model.Nazwa;
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
    var towary = Model.Towary?.ToList() ?? new List<Firma.Services.Data.Dto.Towary.TowarListaItemDto>();
}

<section class="portal-hero mb-4">
    <div class="row g-4 align-items-center">
        <div class="col-12 col-lg-8">
            <span class="portal-badge">🏭 Producent</span>

            <h1 class="display-6 fw-bold mt-3 mb-3">
                @Model.Nazwa
            </h1>

            @if (!string.IsNullOrWhiteSpace(Model.Opis))
            {
                <p class="hero-text tekst-strony mb-0">
                    @Model.Opis
                </p>
            }
            else
            {
                <p class="hero-text mb-0">
                    Produkty tego producenta są dostępne w katalogu sklepu.
                </p>
            }

            <div class="hero-actions">
                <a asp-controller="Producent"
                   asp-action="Index"
                   class="btn btn-outline-secondary btn-lg">
                    Wróć do producentów
                </a>

                @if (!string.IsNullOrWhiteSpace(Model.StronaWWW))
                {
                    <a href="@Model.StronaWWW"
                       target="_blank"
                       class="btn btn-primary btn-lg">
                        Strona producenta
                    </a>
                }
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="hero-card">
                <div class="hero-card-title">Informacje</div>

                <div class="hero-feature">
                    <strong>@Model.IloscTowarow</strong>
                    <span>Liczba produktów.</span>
                </div>

                <div class="hero-feature">
                    <strong>
                        @if (!string.IsNullOrWhiteSpace(Model.Kraj))
                        {
                            @Model.Kraj
                        }
                        else
                        {
                            <text>Brak danych</text>
                        }
                    </strong>
                    <span>Kraj producenta.</span>
                </div>

                <div class="hero-feature">
                    <strong>
                        @if (!string.IsNullOrWhiteSpace(Model.StronaWWW))
                        {
                            <text>Dostępna</text>
                        }
                        else
                        {
                            <text>Brak</text>
                        }
                    </strong>
                    <span>Strona internetowa.</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="details-card mb-4">
    <span class="home-quick-icon">ℹ️</span>
    <h2 class="h5 mb-3">Dane producenta</h2>

    <dl class="details-list-clean mb-0">
        <dt>Nazwa</dt>
        <dd>@Model.Nazwa</dd>

        <dt>Kraj</dt>
        <dd>
            @if (!string.IsNullOrWhiteSpace(Model.Kraj))
            {
                @Model.Kraj
            }
            else
            {
                <span class="text-muted">brak danych</span>
            }
        </dd>

        <dt>Strona WWW</dt>
        <dd>
            @if (!string.IsNullOrWhiteSpace(Model.StronaWWW))
            {
                <a href="@Model.StronaWWW" target="_blank">@Model.StronaWWW</a>
            }
            else
            {
                <span class="text-muted">brak danych</span>
            }
        </dd>

        <dt>Liczba produktów</dt>
        <dd>@Model.IloscTowarow</dd>
    </dl>
</section>

<section class="section-heading mb-4">
    <div>
        <span class="portal-badge">🧩 Produkty</span>
        <h2 class="h3 mt-2 mb-2">Produkty producenta</h2>
        <p class="text-muted mb-0">
            Aktywne towary powiązane z tym producentem.
        </p>
    </div>

    <div class="section-summary">
        <strong>@towary.Count</strong>
        <span>produktów</span>
    </div>
</section>

@if (towary.Any())
{
    <section class="product-grid">
        @foreach (var item in towary)
        {
            <article class="product-card product-card-clear">
                <a asp-controller="Sklep"
                   asp-action="Szczegoly"
                   asp-route-id="@item.IdTowaru"
                   class="product-image-link">
                    @if (!string.IsNullOrWhiteSpace(item.FotoUrl))
                    {
                        <img src="@item.FotoUrl"
                             alt="@item.Nazwa"
                             class="product-card-img" />
                    }
                    else
                    {
                        <img src="~/content/CA.png"
                             alt="@item.Nazwa"
                             class="product-card-img" />
                    }
                </a>

                <div class="product-card-body">
                    <div class="product-meta">
                        <span>@item.Rodzaj</span>
                        <span>@item.Producent</span>
                    </div>

                    <h3 class="product-title">
                        <a asp-controller="Sklep"
                           asp-action="Szczegoly"
                           asp-route-id="@item.IdTowaru">
                            @item.Nazwa
                        </a>
                    </h3>

                    <div class="product-code">
                        Kod: @item.Kod
                    </div>

                    <p class="product-description tekst-skrot">
                        @item.Opis
                    </p>

                    <div class="product-info-row">
                        <div>
                            <span>💰 Cena</span>
                            <strong class="price-text">@item.Cena.ToString("C")</strong>
                        </div>

                        <div>
                            <span>📦 Dostępność</span>

                            @if (item.CzyDostepny)
                            {
                                <strong>@item.IloscSztuk szt.</strong>
                            }
                            else
                            {
                                <strong>brak danych</strong>
                            }
                        </div>
                    </div>

                    <div class="product-card-actions">
                        <a class="btn btn-primary"
                           asp-controller="Sklep"
                           asp-action="Szczegoly"
                           asp-route-id="@item.IdTowaru">
                            Zobacz produkt
                        </a>

                        <a href="/Sklep/Index"
                           class="btn btn-outline-secondary">
                            Sklep
                        </a>
                    </div>
                </div>
            </article>
        }
    </section>
}
else
{
    <div class="empty-state">
        <span class="portal-badge">Brak produktów</span>

        <h2 class="h4 mt-3">Ten producent nie ma aktualnie aktywnych towarów</h2>

        <p>
            Możesz wrócić do pełnej oferty sklepu i sprawdzić produkty innych producentów.
        </p>

        <a href="/Sklep/Index"
           class="btn btn-primary">
            Przejdź do sklepu
        </a>
    </div>
}