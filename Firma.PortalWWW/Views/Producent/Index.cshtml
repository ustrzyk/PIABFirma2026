@model IEnumerable<Firma.Services.Data.Dto.Producenci.ProducentListaItemDto>

@{
    ViewData["Title"] = "Producenci";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

<div class="portal-header mb-4">
    <div>
        <h1 class="h3 mb-1">Producenci</h1>
        <p class="text-muted mb-0">
            Lista producentów dostępnych w sklepie.
        </p>
    </div>
</div>

<div class="card page-card shadow-sm">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive desktop-table-wrap">
                <table class="table table-hover align-middle mb-0 sklep-table">
                    <thead>
                        <tr>
                            <th>Nazwa</th>
                            <th>Kraj</th>
                            <th>Strona WWW</th>
                            <th>Opis</th>
                            <th>Towary</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Nazwa</strong>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Kraj))
                                    {
                                        @item.Kraj
                                    }
                                    else
                                    {
                                        <span class="text-muted">brak</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.StronaWWW))
                                    {
                                        <a href="@item.StronaWWW" target="_blank" class="btn btn-sm btn-outline-secondary">
                                            Strona
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">brak</span>
                                    }
                                </td>

                                <td>
                                    <span class="text-muted tekst-skrot">@item.Opis</span>
                                </td>

                                <td>
                                    <span class="badge bg-secondary">@item.IloscTowarow</span>
                                </td>

                                <td class="text-end">
                                    <a class="btn btn-sm btn-primary"
                                       asp-controller="Producent"
                                       asp-action="Szczegoly"
                                       asp-route-id="@item.IdProducenta">
                                        Szczegóły
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mobile-card-list p-3">
                @foreach (var item in Model)
                {
                    <div class="mobile-info-card">
                        <div class="mobile-info-body">
                            <div class="d-flex justify-content-between gap-2 mb-2">
                                <div>
                                    <h2 class="h6 mb-1">@item.Nazwa</h2>

                                    @if (!string.IsNullOrWhiteSpace(item.Kraj))
                                    {
                                        <div class="small text-muted">@item.Kraj</div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted">brak kraju</div>
                                    }
                                </div>

                                <div class="text-end">
                                    <span class="badge bg-secondary">@item.IloscTowarow</span>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.Opis))
                            {
                                <div class="small text-muted tekst-skrot mb-3">
                                    @item.Opis
                                </div>
                            }

                            <div class="d-flex gap-2">
                                <a class="btn btn-primary flex-fill"
                                   asp-controller="Producent"
                                   asp-action="Szczegoly"
                                   asp-route-id="@item.IdProducenta">
                                    Szczegóły
                                </a>

                                @if (!string.IsNullOrWhiteSpace(item.StronaWWW))
                                {
                                    <a href="@item.StronaWWW"
                                       target="_blank"
                                       class="btn btn-outline-secondary flex-fill">
                                        Strona
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="p-4">
                <div class="alert alert-info mb-0">
                    Brak producentów do wyświetlenia.
                </div>
            </div>
        }
    </div>
</div>