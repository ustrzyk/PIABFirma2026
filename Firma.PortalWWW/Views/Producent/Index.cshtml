@model IEnumerable<Firma.Services.Data.Dto.Producenci.ProducentListaItemDto>

@{
    ViewData["Title"] = "Producenci";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
    var producenci = Model?.ToList() ?? new List<Firma.Services.Data.Dto.Producenci.ProducentListaItemDto>();
}

<section class="section-heading mb-4">
    <div>
        <span class="portal-badge">🏭 Producenci</span>
        <h1 class="h2 mt-2 mb-2">Marki dostępne w sklepie</h1>
        <p class="text-muted mb-0">
            Wybierz producenta, żeby zobaczyć jego produkty.
        </p>
    </div>

    <div class="section-summary">
        <strong>@producenci.Count</strong>
        <span>producentów</span>
    </div>
</section>

@if (producenci.Any())
{
    <section class="producer-grid">
        @foreach (var item in producenci)
        {
            <article class="producer-card">
                <div class="producer-card-icon">🏭</div>

                <div class="product-meta mb-3">
                    @if (!string.IsNullOrWhiteSpace(item.Kraj))
                    {
                        <span>@item.Kraj</span>
                    }
                    else
                    {
                        <span>brak kraju</span>
                    }

                    <span>@item.IloscTowarow produktów</span>
                </div>

                <h2 class="h4 mb-2">
                    <a asp-controller="Producent"
                       asp-action="Szczegoly"
                       asp-route-id="@item.IdProducenta">
                        @item.Nazwa
                    </a>
                </h2>

                <p class="text-muted tekst-skrot">
                    @if (!string.IsNullOrWhiteSpace(item.Opis))
                    {
                        @item.Opis
                    }
                    else
                    {
                        <text>Brak opisu producenta.</text>
                    }
                </p>

                <div class="producer-card-actions">
                    <a class="btn btn-primary"
                       asp-controller="Producent"
                       asp-action="Szczegoly"
                       asp-route-id="@item.IdProducenta">
                        Produkty
                    </a>

                    @if (!string.IsNullOrWhiteSpace(item.StronaWWW))
                    {
                        <a href="@item.StronaWWW"
                           target="_blank"
                           class="btn btn-outline-secondary">
                            WWW
                        </a>
                    }
                </div>
            </article>
        }
    </section>
}
else
{
    <div class="empty-state">
        <span class="portal-badge">Brak producentów</span>

        <h2 class="h4 mt-3">Nie ma aktywnych producentów</h2>

        <p>
            Po dodaniu producentów w Intranecie będą widoczni w tym miejscu.
        </p>

        <a href="/Sklep/Index"
           class="btn btn-primary">
            Przejdź do sklepu
        </a>
    </div>
}