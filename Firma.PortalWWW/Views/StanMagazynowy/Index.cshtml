@model IEnumerable<Firma.Services.Data.Dto.StanyMagazynowe.StanMagazynowyListaItemDto>

@{
    ViewData["Title"] = "Dostępność";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
    var stany = Model?.ToList() ?? new List<Firma.Services.Data.Dto.StanyMagazynowe.StanMagazynowyListaItemDto>();
    var niskieStany = stany.Count(s => s.CzyMaloTowaru);
}

<section class="section-heading mb-4">
    <div>
        <span class="portal-badge">Dostępność</span>
        <h1 class="h2 mt-2 mb-2">Stany magazynowe produktów</h1>
        <p class="text-muted mb-0">
            Szybki podgląd dostępności towarów w sklepie.
        </p>
    </div>

    <div class="section-summary">
        <strong>@stany.Count</strong>
        <span>pozycji</span>
    </div>
</section>

@if (stany.Any())
{
    <section class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="info-tile">
                <span class="info-tile-number">Towary</span>
                <h2 class="h5">@stany.Count</h2>
                <p>Łączna liczba widocznych pozycji magazynowych.</p>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="info-tile">
                <span class="info-tile-number">Niskie stany</span>
                <h2 class="h5">@niskieStany</h2>
                <p>Pozycje, które są na poziomie minimum lub niżej.</p>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="info-tile">
                <span class="info-tile-number">Dostępne sztuki</span>
                <h2 class="h5">@stany.Sum(s => s.IloscSztuk)</h2>
                <p>Łączna ilość sztuk pokazanych w zestawieniu.</p>
            </div>
        </div>
    </section>

    <section class="product-grid">
        @foreach (var item in stany)
        {
            <article class="product-card">
                <div class="product-card-body">
                    <div class="product-meta mb-3">
                        <span>@item.Rodzaj</span>
                        <span>@item.Producent</span>
                    </div>

                    <h2 class="product-title">
                        <a asp-controller="StanMagazynowy"
                           asp-action="Szczegoly"
                           asp-route-id="@item.IdStanuMagazynowego">
                            @item.NazwaTowaru
                        </a>
                    </h2>

                    <div class="product-code">
                        Kod: @item.KodTowaru
                    </div>

                    <dl class="details-list-clean mb-3">
                        <dt>Ilość</dt>
                        <dd>@item.IloscSztuk szt.</dd>

                        <dt>Minimum</dt>
                        <dd>@item.MinimalnaIlosc szt.</dd>

                        <dt>Lokalizacja</dt>
                        <dd>
                            @if (!string.IsNullOrWhiteSpace(item.Lokalizacja))
                            {
                                @item.Lokalizacja
                            }
                            else
                            {
                                <span class="text-muted">brak danych</span>
                            }
                        </dd>
                    </dl>

                    <div class="product-card-footer">
                        <div>
                            @if (item.CzyMaloTowaru)
                            {
                                <span class="availability-badge unavailable">
                                    niski stan
                                </span>
                            }
                            else
                            {
                                <span class="availability-badge available">
                                    stan OK
                                </span>
                            }
                        </div>

                        <a class="btn btn-primary"
                           asp-controller="StanMagazynowy"
                           asp-action="Szczegoly"
                           asp-route-id="@item.IdStanuMagazynowego">
                            Szczegóły
                        </a>
                    </div>
                </div>
            </article>
        }
    </section>
}
else
{
    <div class="empty-state">
        <h2 class="h4">Brak danych magazynowych</h2>
        <p>Nie ma aktywnych stanów magazynowych do wyświetlenia.</p>

        <a asp-controller="Sklep"
           asp-action="Index"
           class="btn btn-primary">
            Przejdź do sklepu
        </a>
    </div>
}