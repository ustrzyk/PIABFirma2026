@model IEnumerable<Firma.Services.Data.Dto.StanyMagazynowe.StanMagazynowyListaItemDto>

@{
    ViewData["Title"] = "Stany magazynowe";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

<div class="portal-header mb-4">
    <div>
        <h1 class="h3 mb-1">Stany magazynowe</h1>
        <p class="text-muted mb-0">
            Podgląd dostępności produktów w sklepie.
        </p>
    </div>
</div>

<div class="card page-card shadow-sm">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 sklep-table">
                    <thead>
                        <tr>
                            <th>Towar</th>
                            <th>Kod</th>
                            <th>Rodzaj</th>
                            <th>Producent</th>
                            <th>Ilość</th>
                            <th>Minimum</th>
                            <th>Lokalizacja</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.NazwaTowaru</strong>
                                </td>
                                <td>@item.KodTowaru</td>
                                <td>@item.Rodzaj</td>
                                <td>@item.Producent</td>
                                <td>@item.IloscSztuk</td>
                                <td>@item.MinimalnaIlosc</td>
                                <td>@item.Lokalizacja</td>
                                <td>
                                    @if (item.CzyMaloTowaru)
                                    {
                                        <span class="badge bg-warning text-dark">mało</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">OK</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-primary"
                                       asp-controller="StanMagazynowy"
                                       asp-action="Szczegoly"
                                       asp-route-id="@item.IdStanuMagazynowego">
                                        Szczegóły
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-4">
                <div class="alert alert-info mb-0">
                    Brak stanów magazynowych do wyświetlenia.
                </div>
            </div>
        }
    </div>
</div>