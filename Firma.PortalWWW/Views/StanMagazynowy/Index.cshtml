@model IEnumerable<Firma.Services.Data.Dto.StanyMagazynowe.StanMagazynowyListaItemDto>

@{
    ViewData["Title"] = "Dostępność";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";

    var stany = Model?.ToList() ?? new List<Firma.Services.Data.Dto.StanyMagazynowe.StanMagazynowyListaItemDto>();
    var niskieStany = stany.Count(s => s.CzyMaloTowaru);
    var dostepnePozycje = stany.Count(s => s.IloscSztuk > 0);
    var sumaSztuk = stany.Sum(s => s.IloscSztuk);
}

<section class="section-heading mb-4">
    <div>
        <span class="portal-badge">📦 Dostępność</span>

        <h1 class="h2 mt-2 mb-2">
            Stany magazynowe produktów
        </h1>

        <p class="text-muted mb-0">
            Sprawdź, które produkty są dostępne przed dodaniem ich do koszyka.
        </p>
    </div>

    <div class="section-summary">
        <strong>@stany.Count</strong>
        <span>pozycji</span>
    </div>
</section>

@if (stany.Any())
{
    <section class="shop-stats mb-4">
        <div class="shop-stat-card">
            <span class="shop-stat-icon">🧩</span>
            <div>
                <span>Pozycje magazynowe</span>
                <strong>@stany.Count</strong>
            </div>
        </div>

        <div class="shop-stat-card">
            <span class="shop-stat-icon">✅</span>
            <div>
                <span>Dostępne produkty</span>
                <strong>@dostepnePozycje</strong>
            </div>
        </div>

        <div class="shop-stat-card">
            <span class="shop-stat-icon">⚠️</span>
            <div>
                <span>Niskie stany</span>
                <strong>@niskieStany</strong>
            </div>
        </div>

        <div class="shop-stat-card">
            <span class="shop-stat-icon">📦</span>
            <div>
                <span>Łącznie sztuk</span>
                <strong>@sumaSztuk</strong>
            </div>
        </div>
    </section>

    <section class="stock-grid">
        @foreach (var item in stany)
        {
            <article class="stock-card @(item.CzyMaloTowaru ? "stock-card-low" : "stock-card-ok")">
                <div class="stock-card-header">
                    <div>
                        <div class="product-meta mb-2">
                            <span>🧩 @item.Rodzaj</span>
                            <span>🏭 @item.Producent</span>
                        </div>

                        <h2 class="h5 mb-1">
                            <a asp-controller="StanMagazynowy"
                               asp-action="Szczegoly"
                               asp-route-id="@item.IdStanuMagazynowego">
                                @item.NazwaTowaru
                            </a>
                        </h2>

                        <div class="product-code">
                            Kod: @item.KodTowaru
                        </div>
                    </div>

                    @if (item.CzyMaloTowaru)
                    {
                        <span class="availability-badge unavailable">
                            niski stan
                        </span>
                    }
                    else
                    {
                        <span class="availability-badge available">
                            stan OK
                        </span>
                    }
                </div>

                <div class="stock-card-values">
                    <div>
                        <span>📦 Ilość</span>
                        <strong>@item.IloscSztuk szt.</strong>
                    </div>

                    <div>
                        <span>🔻 Minimum</span>
                        <strong>@item.MinimalnaIlosc szt.</strong>
                    </div>

                    <div>
                        <span>📍 Lokalizacja</span>
                        <strong>
                            @if (!string.IsNullOrWhiteSpace(item.Lokalizacja))
                            {
                                @item.Lokalizacja
                            }
                            else
                            {
                                <text>brak danych</text>
                            }
                        </strong>
                    </div>
                </div>

                <div class="stock-card-actions">
                    <a class="btn btn-primary"
                       asp-controller="StanMagazynowy"
                       asp-action="Szczegoly"
                       asp-route-id="@item.IdStanuMagazynowego">
                        Szczegóły
                    </a>

                    <a href="/Sklep/Index"
                       class="btn btn-outline-secondary">
                        Sklep
                    </a>
                </div>
            </article>
        }
    </section>
}
else
{
    <div class="empty-state">
        <span class="portal-badge">Brak danych</span>

        <h2 class="h4 mt-3">
            Brak danych magazynowych
        </h2>

        <p>
            Nie ma aktywnych stanów magazynowych do wyświetlenia.
            Możesz przejść do sklepu i sprawdzić aktualną ofertę.
        </p>

        <div class="empty-state-actions">
            <a href="/Sklep/Index"
               class="btn btn-primary">
                Przejdź do sklepu
            </a>

            <a asp-controller="Producent"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Producenci
            </a>
        </div>
    </div>
}