@model Firma.Data.Data.Sklep.StanMagazynowy

@{
    ViewData["Title"] = "Szczegóły stanu magazynowego";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

<div class="portal-header mb-4">
    <div>
        <span class="portal-badge">Magazyn</span>
        <h1 class="h2 mt-2 mb-1">Stan magazynowy</h1>
        <p class="text-muted mb-0">Szczegóły dostępności produktu.</p>
    </div>

    <div class="mt-3 mt-md-0">
        <a class="btn btn-outline-secondary" asp-controller="StanMagazynowy" asp-action="Index">
            Powrót do magazynu
        </a>
    </div>
</div>

<div class="card page-card">
    <div class="card-body p-4">
        <dl class="row details-list mb-0">
            <dt class="col-sm-3">Towar</dt>
            <dd class="col-sm-9">@Model.Towar?.Nazwa</dd>

            <dt class="col-sm-3">Rodzaj</dt>
            <dd class="col-sm-9">@Model.Towar?.Rodzaj?.Nazwa</dd>

            <dt class="col-sm-3">Producent</dt>
            <dd class="col-sm-9">@Model.Towar?.Producent?.Nazwa</dd>

            <dt class="col-sm-3">Ilość sztuk</dt>
            <dd class="col-sm-9">@Model.IloscSztuk</dd>

            <dt class="col-sm-3">Minimalna ilość</dt>
            <dd class="col-sm-9">@Model.MinimalnaIlosc</dd>

            <dt class="col-sm-3">Lokalizacja</dt>
            <dd class="col-sm-9">@Model.Lokalizacja</dd>
        </dl>

        <div class="mt-4 d-flex gap-2 flex-wrap">
            @if (Model.Towar != null)
            {
                <a class="btn btn-primary"
                   asp-controller="Sklep"
                   asp-action="Szczegoly"
                   asp-route-id="@Model.Towar.IdTowaru">
                    Zobacz towar
                </a>
            }

            <a class="btn btn-outline-secondary" asp-controller="StanMagazynowy" asp-action="Index">
                Powrót
            </a>
        </div>
    </div>
</div>
