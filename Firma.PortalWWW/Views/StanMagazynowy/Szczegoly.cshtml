@model Firma.Services.Data.Dto.StanyMagazynowe.StanMagazynowySzczegolyDto

@{
    ViewData["Title"] = "Stan magazynowy";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

<div class="portal-header mb-4">
    <div>
        <h1 class="h3 mb-1">Stan magazynowy</h1>
        <p class="text-muted mb-0">
            Szczegóły dostępności produktu.
        </p>
    </div>

    <a asp-controller="StanMagazynowy"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Powrót do stanów
    </a>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-5">
        <div class="card page-card shadow-sm">
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.FotoUrl))
                {
                    <img src="@Model.FotoUrl"
                         alt="@Model.NazwaTowaru"
                         class="img-fluid rounded product-details-img" />
                }
                else
                {
                    <img src="~/content/CA.png"
                         alt="@Model.NazwaTowaru"
                         class="img-fluid rounded product-details-img" />
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="card page-card shadow-sm h-100">
            <div class="card-body">
                <div class="mb-3">
                    <span class="badge bg-secondary">@Model.Rodzaj</span>
                    <span class="badge bg-light text-dark border">@Model.Producent</span>
                </div>

                <h2 class="h4 mb-3">@Model.NazwaTowaru</h2>

                <p class="text-muted">
                    @Model.OpisTowaru
                </p>

                <dl class="row details-list">
                    <dt class="col-sm-4">Kod towaru</dt>
                    <dd class="col-sm-8">@Model.KodTowaru</dd>

                    <dt class="col-sm-4">Cena</dt>
                    <dd class="col-sm-8">
                        <strong>@Model.CenaTowaru.ToString("C")</strong>
                    </dd>

                    <dt class="col-sm-4">Rodzaj</dt>
                    <dd class="col-sm-8">@Model.Rodzaj</dd>

                    <dt class="col-sm-4">Producent</dt>
                    <dd class="col-sm-8">@Model.Producent</dd>

                    <dt class="col-sm-4">Ilość sztuk</dt>
                    <dd class="col-sm-8">
                        @if (Model.CzyDostepny)
                        {
                            <span class="badge bg-success">@Model.IloscSztuk szt.</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">brak</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Minimalna ilość</dt>
                    <dd class="col-sm-8">@Model.MinimalnaIlosc</dd>

                    <dt class="col-sm-4">Lokalizacja</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrWhiteSpace(Model.Lokalizacja))
                        {
                            @Model.Lokalizacja
                        }
                        else
                        {
                            <span class="text-muted">brak danych</span>
                        }
                    </dd>
                </dl>

                @if (Model.CzyMaloTowaru)
                {
                    <div class="alert alert-warning mb-3">
                        Ilość produktu jest niska względem minimalnego stanu magazynowego.
                    </div>
                }

                @if (Model.IdTowaru > 0)
                {
                    <a class="btn btn-primary"
                       asp-controller="Sklep"
                       asp-action="Szczegoly"
                       asp-route-id="@Model.IdTowaru">
                        Zobacz towar
                    </a>
                }
            </div>
        </div>
    </div>
</div>