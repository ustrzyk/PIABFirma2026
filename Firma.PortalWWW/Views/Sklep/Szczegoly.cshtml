@model Firma.Services.Data.Dto.Towary.TowarSzczegolyDto

@{
    ViewData["Title"] = Model.Nazwa;
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

@if (TempData["KoszykKomunikat"] != null)
{
    <div class="alert alert-info d-flex flex-wrap align-items-center justify-content-between gap-2">
        <span>@TempData["KoszykKomunikat"]</span>

        <a asp-controller="Koszyk"
           asp-action="Index"
           class="alert-link">
            Przejdź do koszyka
        </a>
    </div>
}

<section class="product-details-hero mb-4">
    <div class="row g-4 align-items-stretch">
        <div class="col-12 col-lg-5">
            <div class="product-details-gallery">
                @if (!string.IsNullOrWhiteSpace(Model.FotoUrl))
                {
                    <img src="@Model.FotoUrl"
                         alt="@Model.Nazwa"
                         class="product-details-img" />
                }
                else
                {
                    <img src="~/content/CA.png"
                         alt="@Model.Nazwa"
                         class="product-details-img" />
                }
            </div>
        </div>

        <div class="col-12 col-lg-7">
            <div class="product-details-panel">
                <div class="product-meta mb-3">
                    <span>🧩 @Model.Rodzaj</span>
                    <span>🏭 @Model.Producent</span>
                    <span>🔖 @Model.Kod</span>
                </div>

                <h1 class="h2 mb-3">@Model.Nazwa</h1>

                <p class="product-details-description">
                    @Model.Opis
                </p>

                <div class="product-buy-box">
                    <div>
                        <div class="small text-muted">Cena produktu</div>
                        <div class="price-text product-details-price">
                            @Model.Cena.ToString("C")
                        </div>
                    </div>

                    <div>
                        @if (Model.CzyDostepny)
                        {
                            <span class="availability-badge available">
                                📦 dostępny: @Model.IloscSztuk szt.
                            </span>
                        }
                        else
                        {
                            <span class="availability-badge unavailable">
                                📦 brak danych
                            </span>
                        }
                    </div>
                </div>

                @if (Model.CzyMaloTowaru)
                {
                    <div class="alert alert-warning mt-3 mb-0">
                        Niski stan magazynowy.
                    </div>
                }

                <div class="product-details-actions">
                    @if (Model.CzyDostepny)
                    {
                        <form asp-controller="Koszyk"
                              asp-action="Dodaj"
                              method="post"
                              class="product-buy-form">
                            <input type="hidden" name="idTowaru" value="@Model.IdTowaru" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />

                            <input type="number"
                                   name="ilosc"
                                   value="1"
                                   min="1"
                                   max="20"
                                   class="form-control" />

                            <button type="submit" class="btn btn-primary">
                                <span class="btn-icon">🛒</span>
                                Dodaj do koszyka
                            </button>
                        </form>
                    }

                    <a href="/Sklep/Index"
                       class="btn btn-outline-secondary">
                        Wróć do sklepu
                    </a>

                    @if (!string.IsNullOrWhiteSpace(Model.StronaWWWProducenta))
                    {
                        <a href="@Model.StronaWWWProducenta"
                           target="_blank"
                           class="btn btn-outline-secondary">
                            Strona producenta
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<section class="product-info-panels mb-4">
    <div class="details-card">
        <span class="home-quick-icon">ℹ️</span>
        <h2 class="h5 mb-3">Najważniejsze informacje</h2>

        <dl class="details-list details-list-clean mb-0">
            <dt>Kod produktu</dt>
            <dd>@Model.Kod</dd>

            <dt>Rodzaj</dt>
            <dd>@Model.Rodzaj</dd>

            <dt>Producent</dt>
            <dd>@Model.Producent</dd>

            <dt>Kraj producenta</dt>
            <dd>
                @if (!string.IsNullOrWhiteSpace(Model.KrajProducenta))
                {
                    @Model.KrajProducenta
                }
                else
                {
                    <span class="text-muted">brak danych</span>
                }
            </dd>

            <dt>Lokalizacja</dt>
            <dd>
                @if (!string.IsNullOrWhiteSpace(Model.Lokalizacja))
                {
                    @Model.Lokalizacja
                }
                else
                {
                    <span class="text-muted">brak danych</span>
                }
            </dd>
        </dl>
    </div>

    <div class="details-card">
        <span class="home-quick-icon">📦</span>
        <h2 class="h5 mb-3">Dostępność</h2>

        @if (Model.CzyDostepny)
        {
            <div class="stock-box stock-box-ok">
                <strong>@Model.IloscSztuk szt.</strong>
                <span>Produkt jest dostępny do zamówienia.</span>
            </div>
        }
        else
        {
            <div class="stock-box">
                <strong>Brak danych</strong>
                <span>Dostępność nie została jeszcze uzupełniona.</span>
            </div>
        }

        <div class="simple-note mt-3">
            Po dodaniu produktu do koszyka możesz zmienić ilość przed potwierdzeniem zamówienia.
        </div>
    </div>
</section>

<section class="details-card">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <span class="portal-badge">Pliki</span>
            <h2 class="h5 mt-2 mb-1">Załączniki do produktu</h2>
            <p class="text-muted mb-0">
                Instrukcje, karty produktu lub dodatkowe materiały.
            </p>
        </div>
    </div>

    @if (Model.Zalaczniki != null && Model.Zalaczniki.Any())
    {
        <div class="attachment-grid">
            @foreach (var item in Model.Zalaczniki)
            {
                <article class="attachment-card">
                    <div>
                        <div class="d-flex justify-content-between gap-2 mb-2">
                            <h3 class="h6 mb-0">@item.NazwaOryginalna</h3>

                            @if (item.CzyObraz)
                            {
                                <span class="badge bg-success">obraz</span>
                            }
                            else if (item.CzyPdf)
                            {
                                <span class="badge bg-danger">PDF</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">plik</span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.Opis))
                        {
                            <p class="small text-muted mb-2">@item.Opis</p>
                        }

                        <div class="small text-muted">
                            @item.RozmiarTekst · @item.DataDodania.ToString("dd.MM.yyyy")
                        </div>
                    </div>

                    <a href="@item.Sciezka"
                       target="_blank"
                       class="btn btn-primary w-100">
                        Otwórz
                    </a>
                </article>
            }
        </div>
    }
    else
    {
        <div class="empty-state empty-state-small">
            Ten produkt nie ma załączników.
        </div>
    }
</section>