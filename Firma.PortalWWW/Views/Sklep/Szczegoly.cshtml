@model Firma.Data.Data.Sklep.Towar

@{
    ViewData["Title"] = Model.Nazwa;
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
}

<div class="portal-header mb-4">
    <div>
        <span class="portal-badge">Produkt</span>
        <h1 class="h2 mt-2 mb-1">@Model.Nazwa</h1>
        <p class="text-muted mb-0">Szczegóły produktu dostępnego w ofercie.</p>
    </div>

    <div class="mt-3 mt-md-0">
        <a class="btn btn-outline-secondary" asp-controller="Sklep" asp-action="Index">
            Powrót do sklepu
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-5">
        <div class="card page-card h-100">
            <div class="card-body p-4 text-center">
                @if (!string.IsNullOrWhiteSpace(Model.FotoUrl))
                {
                    <img src="@Model.FotoUrl"
                         alt="@Model.Nazwa"
                         class="product-details-img" />
                }
                else
                {
                    <img src="~/content/CA.png"
                         alt="@Model.Nazwa"
                         class="product-details-img" />
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="card page-card h-100">
            <div class="card-body p-4">
                <h2 class="h4 mb-3">Informacje o produkcie</h2>

                <dl class="row details-list mb-0">
                    <dt class="col-sm-4">Kod</dt>
                    <dd class="col-sm-8">@Model.Kod</dd>

                    <dt class="col-sm-4">Cena</dt>
                    <dd class="col-sm-8 fw-bold price-text">@Model.Cena.ToString("C")</dd>

                    <dt class="col-sm-4">Rodzaj</dt>
                    <dd class="col-sm-8">@Model.Rodzaj?.Nazwa</dd>

                    <dt class="col-sm-4">Producent</dt>
                    <dd class="col-sm-8">@Model.Producent?.Nazwa</dd>

                    <dt class="col-sm-4">Dostępność</dt>
                    <dd class="col-sm-8">
                        @if (Model.StanMagazynowy != null && Model.StanMagazynowy.IloscSztuk > 0)
                        {
                            <span class="badge bg-success">@Model.StanMagazynowy.IloscSztuk szt.</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">brak danych</span>
                        }
                    </dd>
                </dl>

                <hr />

                <h3 class="h5">Opis</h3>
                <div class="tekst-strony">
                    @Model.Opis
                </div>

                <div class="mt-4 d-flex gap-2 flex-wrap">
                    <a class="btn btn-primary" asp-controller="Sklep" asp-action="Index">
                        Wróć do listy produktów
                    </a>

                    @if (Model.Producent != null)
                    {
                        <a class="btn btn-outline-primary"
                           asp-controller="Producent"
                           asp-action="Szczegoly"
                           asp-route-id="@Model.IdProducenta">
                            Zobacz producenta
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
