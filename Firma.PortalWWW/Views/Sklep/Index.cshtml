@model IEnumerable<Firma.Services.Data.Dto.Towary.TowarListaItemDto>

@{
    ViewData["Title"] = "Sklep";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
    var towary = Model?.ToList() ?? new List<Firma.Services.Data.Dto.Towary.TowarListaItemDto>();
}

<section class="section-heading mb-4">
    <div>
        <span class="portal-badge">Produkty</span>
        <h1 class="h2 mt-2 mb-2">Sklep z drukarkami 3D i akcesoriami</h1>
        <p class="text-muted mb-0">
            Wybierz produkt i sprawdź szczegóły, cenę oraz dostępność.
        </p>
    </div>

    <div class="section-summary">
        <strong>@towary.Count</strong>
        <span>produktów</span>
    </div>
</section>

@if (towary.Any())
{
    <section class="product-grid">
        @foreach (var item in towary)
        {
            <article class="product-card">
                <a asp-controller="Sklep"
                   asp-action="Szczegoly"
                   asp-route-id="@item.IdTowaru"
                   class="product-image-link">
                    @if (!string.IsNullOrWhiteSpace(item.FotoUrl))
                    {
                        <img src="@item.FotoUrl"
                             alt="@item.Nazwa"
                             class="product-card-img" />
                    }
                    else
                    {
                        <img src="~/content/CA.png"
                             alt="@item.Nazwa"
                             class="product-card-img" />
                    }
                </a>

                <div class="product-card-body">
                    <div class="product-meta">
                        <span>@item.Rodzaj</span>
                        <span>@item.Producent</span>
                    </div>

                    <h2 class="product-title">
                        <a asp-controller="Sklep"
                           asp-action="Szczegoly"
                           asp-route-id="@item.IdTowaru">
                            @item.Nazwa
                        </a>
                    </h2>

                    <div class="product-code">
                        Kod: @item.Kod
                    </div>

                    <p class="product-description tekst-skrot">
                        @item.Opis
                    </p>

                    <div class="product-card-footer">
                        <div>
                            <div class="price-text product-price">
                                @item.Cena.ToString("C")
                            </div>

                            @if (item.CzyDostepny)
                            {
                                <span class="availability-badge available">
                                    @item.IloscSztuk szt.
                                </span>
                            }
                            else
                            {
                                <span class="availability-badge unavailable">
                                    brak danych
                                </span>
                            }
                        </div>

                        <a class="btn btn-primary"
                           asp-controller="Sklep"
                           asp-action="Szczegoly"
                           asp-route-id="@item.IdTowaru">
                            Zobacz
                        </a>
                    </div>
                </div>
            </article>
        }
    </section>
}
else
{
    <div class="empty-state">
        <h2 class="h4">Brak produktów</h2>
        <p>W tej kategorii nie ma aktualnie aktywnych towarów.</p>

        <a asp-controller="Sklep"
           asp-action="Index"
           class="btn btn-primary">
            Wróć do sklepu
        </a>
    </div>
}