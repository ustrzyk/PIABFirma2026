@model IEnumerable<Firma.Services.Data.Dto.Towary.TowarListaItemDto>

@{
    ViewData["Title"] = "Sklep";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
    var towary = Model?.ToList() ?? new List<Firma.Services.Data.Dto.Towary.TowarListaItemDto>();
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var dostepneTowary = towary.Count(t => t.CzyDostepny);
}

<section class="shop-heading mb-4">
    <div>
        <span class="portal-badge">Produkty</span>
        <h1>Sklep z drukarkami 3D i akcesoriami</h1>
        <p>
            Wybierz produkt, sprawdź dostępność i dodaj go do koszyka.
        </p>
    </div>

    <div class="shop-heading-actions">
        <a asp-controller="Koszyk"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <span class="btn-icon">🛒</span>
            Koszyk
        </a>

        <a asp-controller="StatusZamowienia"
           asp-action="Index"
           class="btn btn-primary">
            <span class="btn-icon">🧾</span>
            Status zamówienia
        </a>
    </div>
</section>

<section class="shop-stats mb-4">
    <div class="shop-stat-card">
        <span class="shop-stat-icon">🧩</span>
        <div>
            <span>Produkty</span>
            <strong>@towary.Count</strong>
        </div>
    </div>

    <div class="shop-stat-card">
        <span class="shop-stat-icon">📦</span>
        <div>
            <span>Dostępne</span>
            <strong>@dostepneTowary</strong>
        </div>
    </div>

    <div class="shop-stat-card">
        <span class="shop-stat-icon">ℹ️</span>
        <div>
            <span>Brak danych</span>
            <strong>@(towary.Count - dostepneTowary)</strong>
        </div>
    </div>
</section>

@if (TempData["KoszykKomunikat"] != null)
{
    <div class="alert alert-info d-flex flex-wrap align-items-center justify-content-between gap-2">
        <span>@TempData["KoszykKomunikat"]</span>

        <a asp-controller="Koszyk"
           asp-action="Index"
           class="alert-link">
            Przejdź do koszyka
        </a>
    </div>
}

@if (towary.Any())
{
    <section class="product-grid">
        @foreach (var item in towary)
        {
            <article class="product-card product-card-clear">
                <a asp-controller="Sklep"
                   asp-action="Szczegoly"
                   asp-route-id="@item.IdTowaru"
                   class="product-image-link">
                    @if (!string.IsNullOrWhiteSpace(item.FotoUrl))
                    {
                        <img src="@item.FotoUrl"
                             alt="@item.Nazwa"
                             class="product-card-img" />
                    }
                    else
                    {
                        <img src="~/content/CA.png"
                             alt="@item.Nazwa"
                             class="product-card-img" />
                    }
                </a>

                <div class="product-card-body">
                    <div class="product-meta">
                        <span>@item.Rodzaj</span>
                        <span>@item.Producent</span>
                    </div>

                    <h2 class="product-title">
                        <a asp-controller="Sklep"
                           asp-action="Szczegoly"
                           asp-route-id="@item.IdTowaru">
                            @item.Nazwa
                        </a>
                    </h2>

                    <div class="product-code">
                        Kod: @item.Kod
                    </div>

                    <p class="product-description tekst-skrot">
                        @item.Opis
                    </p>

                    <div class="product-info-row">
                        <div>
                            <span>💰 Cena</span>
                            <strong class="price-text">@item.Cena.ToString("C")</strong>
                        </div>

                        <div>
                            <span>📦 Dostępność</span>

                            @if (item.CzyDostepny)
                            {
                                <strong>@item.IloscSztuk szt.</strong>
                            }
                            else
                            {
                                <strong>brak danych</strong>
                            }
                        </div>
                    </div>

                    <div class="product-card-actions">
                        <a class="btn btn-outline-secondary"
                           asp-controller="Sklep"
                           asp-action="Szczegoly"
                           asp-route-id="@item.IdTowaru">
                            Szczegóły
                        </a>

                        @if (item.CzyDostepny)
                        {
                            <form asp-controller="Koszyk"
                                  asp-action="Dodaj"
                                  method="post">
                                <input type="hidden" name="idTowaru" value="@item.IdTowaru" />
                                <input type="hidden" name="ilosc" value="1" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />

                                <button type="submit" class="btn btn-primary">
                                    <span class="btn-icon">🛒</span>
                                    Do koszyka
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="availability-badge unavailable">
                                niedostępny
                            </span>
                        }
                    </div>
                </div>
            </article>
        }
    </section>
}
else
{
    <div class="empty-state">
        <span class="portal-badge">Brak wyników</span>

        <h2 class="h4 mt-3">Nie znaleziono aktywnych produktów</h2>

        <p>
            W tej kategorii nie ma aktualnie produktów do wyświetlenia.
            Możesz wrócić do pełnej oferty albo sprawdzić inne sekcje portalu.
        </p>

        <div class="empty-state-actions">
            <a href="/Sklep/Index"
               class="btn btn-primary">
                Pokaż wszystkie produkty
            </a>

            <a asp-controller="Promocja"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Zobacz promocje
            </a>

            <a asp-controller="Producent"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Producenci
            </a>
        </div>
    </div>
}